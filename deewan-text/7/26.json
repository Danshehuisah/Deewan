{
    "id": 26,
    "title": "حرف الظاء",
    "huruf": [
      ["ظِمَائِي بِخَيْرِ الْهَاشِمِي الدَّهْرَ لَنْ يُرْوَا", "وَقَدْ لَذَّ ذِكْرَاهُ لَكَالْمَنِّ وَالسَّلْوَى"],
      ["ذَرِينِيَ دَعْدًا أَنَّ قَلْبِيَ لَنْ يَهْوَا", "سِوَى أَحْمَدٍ مَاحِ الضَّلَالَاتِ وَالْبَلْوَى"],
      ["ظَلَمْتُ إِذَا كَابَدْتُّ حُبَّ سِوَائِهِ", "وَطَاهَ حَبَانِي نِلْتُ غَايَتِيَ الْقُصْوَا"],
      ["وَهُو خَيْرُ خَلْقِ اللَّهِ خَلْقًا وَخِلْقَةً", "لِوَاالْحَمْدِ فِي كَفَّيْهِ أَيْنَ لَهُ شَرْوَا"],
      ["تَحَدَّيْتُ بِالْهَادِي الْعِبَادِ فَمَنْ لَهُ", "رَسُولٌ كَمِثْلِ الْهَاشِمِيَّ أَبِي الْأَضْوَا"],
      ["أَبِي الْقَاسِمِ الْمَنْصُورِ بِاللَّهِ وَحْدَهُ", "شَفِيعِي وَمَامُونِي الْمَكِّي رَاكِبِ الْقَصْوَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تَقِينَا بِهَا البَاسَاءَ وَالضُّرَّ وَاللَّأْوَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تَقِينَا جَمِيعَ الشَّرِّ وَالْبَغْيِ وَاللَّغْوَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُنِيلُ الْمُنَى لِلْعَبْدِ وَالْتَكْفِهِ الْبَلْوَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُسَخِّرُلِي دَهْرِي وَتَحْفَظُ لِي الْمَثْوَا"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "وَمَنْ سَلَكُواْ نَهْجَ الْأَمِينِ وَمَنْ يَهْوَا"]
    ]
  }