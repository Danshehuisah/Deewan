{
    "id": 20,
    "title": "حرف الراء",
    "huruf": [
      ["رَفَعْتُ لِوَاءَ الدِّينِ بِالذِّكْرِ صَارِخَا", "وَذِكْرِي وَوُدِّي كَانَ فِي الْقَلْبِ رَاسِخَا"],
      ["فَفِيمَا أُحَيْلَى ذِكْرَ طَاهَ مُحَمَّدٍ", "رَسُولٌ أَتَى بِالذِّكْرِ لِلْغَيْرِ نَاسِخَا"],
      ["أَلَا اعْتَصِمُواْ بِالْحَبْلِ حَبْلِ مُحَمَّدٍ", "رِجَالًا وَأَطْفَالًا نِسًا وَمَشَائِخَا"],
      ["تَفُوقُواْ رِجَالًا مُدْلِجِينَ قَدْ أَدْمَنُوا", "مَسِيرًا وَجَابُوا فَدْفَدًا وَسَرَابِخَا"],
      ["بِخَيْرِ نَبِيٍّ جَاءَ مِنْ خَيْرِ مَالِكٍ", "بِبَرْزَخِ أَقْطَابٍ قَدْ أَمْسُوا بَرَازِخَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تَوَاصَلَنِي مَا جِئْتَ حِسًّا فَرَاسِخَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَأَعْلُو بِهَادِي الْخَلْقِ الشُّمَّ الشَّوَامِخَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَهِدُّ بِذِكْرَاهُ الْجِبَالَ الرَّوَاسِخَا"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "وَكُلُّهُمُ بِالذِّكْرِ قَدْ كَانَ صَارِخَا"]
    ]
  }