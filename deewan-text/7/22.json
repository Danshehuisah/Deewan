{
    "id": 22,
    "title": "حرف التاء",
    "huruf": [
      ["تَرَانِي سَمِيرَ النَّجْمِ بِالَّيْلِ حَافِظَا", "وِدَادَ الْمُقَفَّى لِلْعُهُودِ مُحَافِظَا"],
      ["عَلَى الْخَدِّ دَمْعِي يَرْجُفُ الْقَلْبَ مَوْهِنًا", "أُنَاشِدُ أَشْعَارَ الْمُحَبَّةِ لَافِظَا"],
      ["تَرَى الشِّيبَ أَمْثَالِي سُجُودًا قَدْ أَخْلَصُوا", "لَدَى الذِّكْرِ تُلْفِي الْكُلَّ لِلذِّكْرِ حَافِظَا"],
      ["وَحَسْبِيَ مَدْحُ الْمُنْحَمِنَّا وَذِكْرُهُ", "فَلَمْ أَلْتَفِتْ لِلْغَيْرِ دَهْرًا مَلَاحِظَا"],
      ["شَفِيعُ الْوَرَى لَيْثُ الْعَرُوبَةِ مَرْكَزًا", "لِشَرْعِ إِلَاهِ الْعَرْشِ لِلْخَلْقِ وَاعِظَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَرُحْتُ إِلَيْكَ مِثْلُ مَنْرَاحَ قَارِظَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ عَنْهُ لَاقُواْ الْمَوَاعِظَا"]
    ]
  }