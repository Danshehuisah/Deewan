{
    "id": 17,
    "title": "حرف الفاء",
    "huruf": [
      ["فَإِنَّ مَدِيحَ الْهَاشِمِيِّ سِلَاحِي", "وَجَيْشِي بِهِ أَغْزُواْ طِوَالَ الرِّمَاحِ"],
      ["مَتَى عَسْكَرُوا أَوْ نَازَلُواْ فَخَدِيمُهُ", "يُرَدِّدُ رَبِّي فِي الْمَسَا وَالصَّبَاحِ"],
      ["وَإِنِّي بِهِ أَغْزُو الْعِدَى وَأَبِيدُهُمْ", "بِدُونِ رِجَالٍ أَوْ بِدُونِ سِلَاحِ"],
      ["يَخَافُوْنَ مِنِّي كُلَّ يَوْمِ مَدَافِعًا", "وَحَسْبِي دِفَاعُ اللَّهِ فِيهِ سِلَاحِي"],
      ["إِذَا مَا اُنَاجِى خُفْيَةً فَهَلَاكُهُمْ", "بِدُونِ قِتَالٍ بَلْ بِدُونِ جِرَامِ"],
      ["لِمَنْ مُلْكُ هَذَا الْأَرْضِ يَوْمِي وَقَبْلَهُ", "فَلِلْوَاحِدِ الْقَهَّارِ مِنْهُ نَجَاحِي"],
      ["كَفَانِي كَفَانِي مَا بَقِيتُ فَلَا أَرَى", "فَسَادًا صَلَاحًا بَلْ أُدِيمُ كَفَاحِي"],
      ["فَإِنَّ فَلَاحَ الْعَالَمِينَ بِقَفْوِ مَنْ", "قَدَاسْدَى لِمَنْ وَالَاهُ كُلَّ فَلَاحِ"],
      ["بِهِ قَدْ عَلَتْ عَرْبُ الْبَسِيطَةِ بَعْدَمَا", "أُذِلُّوا وَضِيمُواْ تَحْتَ كُلِّ جَنَاحِ"],
      ["بِهِ بَرَّعُواْ فِي الْعِلْمِ بَعْدَ جَهَالَةٍ", "وَنَالُواْ بُعَيْدَ الْخُسْرِ كُلَّ رَبَاحِ"],
      ["وَقَدْ كَسَّرُوا كِسْرَى وَدَمَّرَ قَيْصَرَا", "جُيُوشُهُمُ بِالْبِيضِ أَوْ بِالرِّمَاحِ"],
      ["تَرَاهُمْ وَأَبْطَالُ الْبِلَادِ تَخَالُهُمْ", "مِنَ الْجِنِّ وَالْأَمْلَاكِ بَيْنَ السِّلَاحِ"],
      ["فَلَمْ يَاتِ رُوحٌ مِثْلُ رُوحِ مُحَمَّدٍ", "غُدُوِّي بِذِكْرَاهُ وَفِيهِ رَوَاحِي"],
      ["أَصِخْ لِقَوَافِي شَائِبِ الْفَوْدِ قَاصِدٍ", "بِآيَاتِ حُبٍّ فِي الْأَمِينِ صِحَاحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "بِرَاحِ مَدِيحِ السُّكْرِ دُونَ جُنَاحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "مَدِيحُ الْإِمَامِ الْهَاشِمِيِّ جَنَاحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَذِكْرُ الْمُقَفَّى فِي الشُّؤُونِ نَجَاحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "مُحَيَّاهُ إِنْسَانَيْ عُيُونِ مِلَاحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَأَصْحَابٍ وَأَهْلٍ فَلَاحِ"]
    ]
  }