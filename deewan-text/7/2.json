{
    "id": 2,
    "title": "حرف الباء",
    "huruf": [
      ["بِصَوْمِي وَحَجِّي لَمْ أَثِقْ فَالْوَثَائِقُ", "بِفَضْلِ كَرِيمٍ يَوْمَ تُبْلَى الْحَقَائِقُ"],
      ["أُصَلِّي امْتِثَالًا أَذْكُرُ اللَّهَ تَالِيًا", "وَمَا ثَمَّ شَيْءٌ إِنْ تَبَصَّرَ ذَائِقُ"],
      ["تَغَمَّدْ بِفَضْلٍ عَبْدَ سُوْءٍ مُقَصِّرًا", "فَتُنْقِذُهُ ضَاقَتْ عَلَيْهِ الطَّرَائِقُ"],
      ["فَكَمْ ضَاقَ سُبْلُ الْعَبْدِ بِالْكَرْبِ وَالْأَسَى", "وَوَافَا وَاِذْوَافَاكَ زَالَ الْمَضَائِقُ"],
      ["فَقَدْ جِئْتَ بِالدِّينِ الْحَنِيفِ مُهَدِّدًا", "وَدَافَعْتَ عَنْهُ وَالسُّيُوفُ بَوَارِقُ"],
      ["فَئَالَ الْعِدَى مِنْ يَأْسِهِمْ قَدْ تَقَهْقَرُوا", "وَبَيَّنْتَ نَهْجًا فَازَ مِنْهُ الْخَلَائِقُ"],
      ["وَإِنِّي مُحِبٌّ شَاعِرٌ خَادِمٌ لَكُمْ", "وَشَرْحٌ وِدَادِي ضَاقَ مِنْهُ الْمَهَارِقُ"],
      ["تَسَمَّى رِجَالٌ بِالْخَدِيمِ وَإِنَّنِي", "أُسَاجِلُهُمْ لَا أَنْثَنِي وَأُسَابِقُ"],
      ["أُسَابِقُهُمْ مَا عِشْتُ فِيكَ وَإِنْ أَمُتْ", "يُسَاجِلُهُمْ فَرْعِي وَفِيكَ يُسَابِقُ"],
      ["لِحُبِّكَ يَدْعُونِي دَوَاعٍ عَدِيدَةٌ", "جَمَالٌ وَإِحْسَانٌ وَطَبْعٌ مُوَافِقُ"],
      ["شَجَاعَةُ نَفْسٍ وَعَزْمٌ وَعِفَّةٌ", "وَحِلْمٌ وَجُودٌ حَارَ فِيهِ الطَّوَارِقُ"],
      ["وَعَقْلٌ وَزُهْدٌ ثُمَّ حَزْمٌ وَحِكْمَةٌ", "وَصَبْرٌ مَتَى سَاقَ الْبَلِيَّاتِ خَالِقُ"],
      ["وَآيَاتُ صِدْقٍ بَانَ جَهْرًا بِأَنَّهَا", "مِنَ اللَّهِ كُلُّ الْأَمْرِ رَاقَ وَرَائِقُ"],
      ["إِذَانْتَ الَّذِي قَدْ جِئْتَ بِالصِّدْقِ صَادِقًا", "فَإِنَّكَ مَصْدُوقٌ وَاِنَّكَ صَادِقُ"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَبَرْهَامُ حِبٌّ عَاشِقٌ فِيكَ وَامِقُ"],
      ["أَتَعْرِفُ مَنْ أَهْوَاهُ حَقًّا مُحَمَّدًا", "نَبِيٌّ لِكُلِّ الْأَنْبِيَا وَهْوَ سَابِقُ"],
      ["أَتَعْرِفُهُ ذَاكَ الشَّفِيعُ وَاِنَّهُ", "لِوَى الْحَمْدِ فِي كَفَّيْهِ وَالْكُلُّ رَامِقُ"],
      ["أَتَعْرِفُ طَاهَ مَنْ يَلُوذُ بِحِقْوِهِ", "أَبُو الْبَشَرِ الْعَالِي وَبَرْهَامُ لَاحِقُ"],
      ["وَنُوحٌ وَمُوسَى ثُمَّ عِيسَى وَكُلُّهُمْ", "يَرَى أَنَّ هَذَا بِالشَّفَاعَةِ لَائِقُ"],
      ["فَيَشْفَعُ مَحْمُودُ الْمَقَامِ مُشَفَّعًا", "وَمُعْطًا سُئَالًا وَهْوَ بِالْحَقِّ وَاثِقُ"],
      ["أَرَانِي مَعَ الْعِلَّاتِ أَرْمُقُ نَحْوَهُ", "أُرَجِّى الْتِفَاتًا مِنْهُ تَبْدُ الْخَوَارِقُ"],
      ["إِذَا الْتَفَتَ الْهَادِي إِلَيَّ فَإِنَّهُ", "يُغَطِّي ظَلَامِي نُورُهُ وَالْحَقَائِقُ"],
      ["وَيُلْحِقُنِي بِسَّابِقِينَ تَكَرُّمًا", "يُبَاسِطُنِي فِي جَمْعِهِ وَيُعَانِقُ"],
      ["وَيَسْمَعُ مِنِّي ذِكْرَهُ وَمَدِيحَهُ", "يُفَاخِرُ بِي فِي الْأَنْبِيَا وَيُرَافِقُ"],
      ["أَقُولُ لَهُ صَحْبِي وَأَهْلَ مَوَدَّتِي", "فَقَالَ ادْخُلُوا صَحْبَ الْخَدِيمِ تُسَابِقُوا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ سَاجَلُوا وَتَسَابَقُوا"]
    ]
