{
    "id": 8,
    "title": "حرف الحاء",
    "huruf": [
      ["حِبَاءُ رَسُولِ اللَّهِ أُمُّ حِبَائِي", "فَبَحْرِي مَلَاهُ الْهَاشِمِي وَإِنَائِي"],
      ["حُرُوبُ الْعِدَى قَدْ رَدَّهُمْ وَكَفَاهُمُ", "فَبَاؤُوا بِغَيْظٍ خَاسِرِينَ وَرَائِي"],
      ["حَرَامٌ عَلَى رَاعِ الْحِمَى مِثْلَ أَحْمَدٍ", "يَضِلُّ عِقَالٌ عَنْهُ وَسْطَ عَرَاءِ"],
      ["حَمَانِي وَأَعْلَانِي وَأَجْزَلَ نَيْلَهُ", "وَآنَسَنِي إِذْ صَدَّ أَهْلُ قَلَائِي"],
      ["حَفَاوَتُهُ تَابَى الطَّمُوحَ لِغَيْرِهِ", "فَقَاصِدُهُ يُزْرِي مُوَيْهَ إِضَاءِ"],
      ["حَبَانِي مُرَادِي وَالسَّخَاءُ سَجِيَّةٌ", "لِطَاهَ الْإِمَامِ الْهَاشِمِيِّ مُنَائِي"],
      ["وَإِنِّي مُحِبٌّ شَاعِرٌ خَادِمٌ لَهُ", "كَفَانِي شُؤُونِي وَهْوَ زَادُ عَطَائِي"],
      ["لَهُ كُلَّ وَقْتٍ مَا بَقِيتُ مَحَبَّةٌ", "مَدَائِحُ تُبْدِي لِلْأَمِينِ وِلَائِي"],
      ["تَذَكُّرُهُ شُغْلِي وَأُنْسِي وَخِدْمَتِي", "وَذِكْرُ الْمُقَفَّى فِي السِّقَامِ دَوَائِي"],
      ["وَزَادِي وَمَرْكُوبِي وَسَيْفِي وَشَيْظَمِي", "وَجَيْشِي وَدِرْعِي لَمْ أُبَلْ بِعِدَائِي"],
      ["فَمَنْ رَاشَ نَحْوِي فَالْأَمِينُ بِدَوْرِهِ", "يَرِيشُّ لَهُ فَلْيُنْذَرَنْ بِوَبَاءِ"],
      ["وَذِكْرِي حُنَيْنٍ بَعْدَ بَدْرٍ وَخَنْدَقٍ", "وَأُحْدٍ وَفَتْحٍ لَا تَقِلُّ رَجَائِي"],
      ["يَقِينِي يَقِينًا مُصْطَفَى الْكَوْنِ إِذْ صَفَا", "وِدَادِي لَهُ إِذْ فِيهِ عَيْنُ بَقَائِي"],
      ["فَنَيْتُ بِهِ بَعْدَ الْبَقَاءِ فَيَسْتَوِي", "بَقَائِي بِخَيْرِ الْعَالَمِينَ فَنَائِي"],
      ["فَإِنْ دَهِشَ الْأَقْطَابُ يَوْمًا لِمَشْرَبٍ", "أَقُدْهُمْ لِصَحْوِي بِاشْتِدَادِ رُوَائِي"],
      ["فَأَشْرَبُ مِنْ صَحْوِ الْمَحَبَّةِ سَاقِيًا", "فَلَا السُّكْرُ يُلْهِي بَلْ أُدِيمُ سَقَائِي"],
      ["بِيُمْنِ النَّبِيِّ الْهَاشِمِيِّ الَّذِي مَتَى", "تَنَفَّسَ فِي قَلْبِي اسْتَبَانَ ضِيَائِي"],
      ["أَفَاضَ إِلَيَّ مِنْهُ حَقًّا وَإِنَّهُ", "أَفَاضَ لِغَيْرِي مِنْ فُيُوضِ حِبَائِي"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَأَصْحَابٍ بُحُورِ نَدَاءِ"]

    ]
  }