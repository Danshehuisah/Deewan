{
    "id": 29,
    "title": "حرف اللام ألف",
    "huruf": [
      ["لَدَى الْمُصْطَفَى هَبْ لِي رِضًا وَقَبُولَا", "فَقَدْ عَزَّنِى نَيْلِي إِلَيْهِ وُصُولَا"],
      ["وَذَا عَجَبٌ كَالْعِيسِ وَالْمَاءُ فَوْقَهَا", "تَمُوتُ ظِمَاءً مَا تَنَالُ سَبِيلَا"],
      ["وَقَدْ شَدَّ فَقْرِي وَافْتِقَارِي وَلَمْ أَجِدْ", "سِوَى الْمُصْطَفَى الْمَاحِي يُنِيلُ فَتِيلَا"],
      ["جَنَيْتُ كَثِيرًا فَالرَّجَاءُ يَقُودُنِي", "إِلَيْهِ وَءَاثَامِي تَكُونُ كُبُولَا"],
      ["عَلَى أَنَّ أَوْجَاجَ الذُّنُوبِ بِبَحْرِهِ", "بِلَا أَثَرٍ يَبْقَى وَجِئْتُ الرَّسُولَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "يَكُونُ الْمُقَفَّى لِلْعَطَاءِ كَفِيلَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَلَسْتُ أَرَى غَيْرَ الرَّسُولِ وَكِيلَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَقَدْ طَالَمَا أَسْدَى إِلَيَّ جَزِيلَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "مَلَاذِي أَرَاهُ فِي الْخُطُوبِ جَلِيلَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَنَالُ شَفَاعَاتِ الشَّفِيعِ مُنِيلَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَتَخْتَارُ اَنْصَارِى سَرَاةً عُدُولَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَدُومُ بِظِلٍّ لَا يَزَالُ ظَلِيلَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "اُطِيعُ كَحَذْوِى بِانِّعَالِ الرَّسُولَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "إِذَا مِتُّ فِي الْفِرْدَوْسِ نِلْتُ مَقِيلَا"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "عَلَى كُلِّ حَالٍ لَا أَزَالُ كَمِيلَا"]
    ]
  }