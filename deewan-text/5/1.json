{
    "id": 1,
    "title": "حرف الألف",
    "huruf": [
      ["اَبَى لِيَ سِرٌّ حَلَّ بَيْنَ حَشَآءِ", "تَنَاسِي حَبِيبِ اللَّهِ عَيْنِ صَفَآءِ"],
      ["أَهِيمُ بِهِ إِنْ هَامَ غَيْرِي بِزَيْنَبٍ", "وَتَذْكَارُهُ عِنْدِي أَلَذُّ غِذَآءِ"],
      ["أَهِيمُ بِهِ مَا عِشْتُ دُونَ تَغَنُّجٍ", "وَلِي وَلَهٌ فِيهِ بُعَيْدَ فَنَآءِ"],
      ["إِذَا انْصَرَفَ الْوَارُونَ عَنْ دَفْنِ جُثَّتِي", "بَقِيتُ بِهِ أَحْيَا لِيَوْمِ لِقَآءِ"],
      ["إِذَا عَبِدَ الْعُبَّادُ فِي الْقَبْرِ إِنَّنِي", "بِذِكْرِ رَسُولِ اللَّهِ وَقْتَ ثَوَآئِى"],
      ["اَنِسْتُ بِهِ وَحْدِي كَفَانِي جَمَالُهُ", "عَنِ الْغَانِيَاتِ الْبِيضِ وَسْطَ خِبَآئِى"],
      ["إِذَا جَمَعُوا الْاَمْوَالَ وَافْتَخَرُوا بِهَا", "فَفَخْرِي وَمَالِي حُبُّ زَيْنِ مَلَآءِ"],
      ["إِذَا مَكَرُواْ مَكْرًا كُفِيتُ بِذِكْرِهِ", "وَإِنْ مَرَضٌ يَعْرُواْ فَفِيهِ شِفَآئِي"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِيُرْضِي رَسُولَ اللَّهِ كُلُّ ثَنَآئِي"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَكُونُ بِحَشْرِى تَحْتَ ظِلِّ اللِّوَآئِى"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَنَالُ لَدَى الْأُخْرَى كَمَالَ الرِّضَآءِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَيَكْفِي رَسُولُ اللَّهِ أَهْلَ الْبَذَآءِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "يَنَالُ مُحِبِّى الدَّهْرَ كُلَّ مُنَآءِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "خَدِيمُكَ يَعْلُواْ كُلَّ أَهْلِ عَلَآءِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَأَنْوَارُهَا تَعْلُواْ عَنَانَ سَمَآءِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ ثُمَّ آلِ عَبَآءِ"]
    ]
  }