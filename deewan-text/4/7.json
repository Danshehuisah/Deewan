{
    "id": 7,
    "title": "حرف الزاي",
    "huruf": [
      ["زَمَانُ رَسُولِ اللَّهِ خَيْرُ زَمَانِ", "وَطَيْبَةُ خَيْرِ الْخَلْقِ خَيْرُ مَكَانِ"],
      ["فَمَنْ لِي بِكَاْسٍ مِنْ أَرِيسٍ وَرُوْمَةٍ", "فَشَوْقِي إِلَى تِلْكَ الْبِقَاعِ دَهَانِ"],
      ["فَشَوْقِي إِلَى وَادِي الْعَقِيقِ وَسَلْعِهِ", "حَمَانِي مَنَامِي فَالْمَنَامُ جَفَانِي"],
      ["وَشَوْقِي إِلَى وَادِي النَّقَى وَبَقِيعِهِ", "وَلِلصَّخْرَةِ الْمَلْسَا إِلَيْهِ دَعَانِي"],
      ["فَهَلْ تَسْمَحُ الْأَيَّامُ يَوْمًا بِعَوْدَةٍ", "إِلَيْهَا فَهَاتِى بُغْيَتِي وَأَمَانِي"],
      ["وَهَلْ لِيَ أَنْ أَكْسُواْ الْعَتِيقَ وَتَكْتَسِي", "كَذَا الْقُبَّةُ الْخَضْرَاءُ رَوْضُ جَنَانِ"],
      ["وَهَلْ لِيَ فُلْكٌ بَاخِرَاتٌ تُقِلُّ مَنْ", "يُحَجِّجُ بَيْتَ اللَّهِ دُونَ تَوَانِ"],
      ["وَتُدْنِي لَهُمْ أَرْضَ الْحَبِيبِ قِيَادَتِي", "وَقَدْ شِدْتُ بِالْبَطْحَآءِ كُلَّ مَبَانِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً تُزِجُّ الْعَبْدَ وَسْطَ جِنَانِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُعَجِّلُ فَتْحِي وَالْمُنَى وَالْتَّهَانِى"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُضِيءُ جَنَانِى أَوْ تُضِيءُ مَغَانِي"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُمَلِّكُنِي تَصْرِيفَ كُلِّ مَعَانِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً تُنَجِّينَا بِدُونِ مُعَانِ"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "صَلَاةٌ وَتَسْلِيمٌ مُرُورَ الزَّمَانِ"]
    ]
  }