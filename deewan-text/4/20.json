{
    "id": 20,
    "title": "حرف الراء",
    "huruf": [
      ["سَلَامٌ عَلَى عِهْرٍ وَبِيْرِ أَرِيسِ", "تَحِنُّ قِلَامِي نَحْوَهَا وَنُقُوسِي"],
      ["مَشَارِبُ خَيْرِ الْخَلْقِ صَفْوَةِ خَلْقِهِ", "وَأَعْظَمُ مَلْكٍ سَاسَ كُلَّ نُفُوسِ"],
      ["وَقَدْ أَفْصَحَتْ نُطْقُ الْجَمَادَاتِ اِنَّهُ", "لِأَفْضَلُ مَخْلُوقٍ غَزَا بِخَمِيسِ"],
      ["وَقَدْ بَرِعَتْ فِي الْعِلْمِ عُجْمٌ بِسِرِّهِ", "وَطَاوَعَهُ لِلرُّشْدِ كُلُّ رَئِيسِ"],
      ["وَقَدْ سَحَقَتْ أَصْحَابُهُ كُلَّ مُجْرِمٍ", "وَقَدْ عَبَقَتْ بِالطِّيبِ بِيرُ أَرِيسِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ قَدْ سَخَوْا بِنَفِيسِ"]
    ]
  }