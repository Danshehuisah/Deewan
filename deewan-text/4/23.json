{
    "id": 23,
    "title": "حرف الثاء",
    "huruf": [
      ["ذَكَرْتُ رَسُولَ اللَّهِ ذِكْرَ تَلَذُّذِ", "بِشَيْءٍ سِوَاهُ الدَّهْرَ لَمْ أَتَلَذَّذِ"],
      ["وَهَلْ ثَمَّ غَيْرُ الْمُصْطَفَى وَجَمَالِهِ", "وَهَلْ ثَمَّ مِنْ هَادٍ سِوَاهُ وَمُنْقِذِ"],
      ["ذَرِينِيَ يَا سَلْمَى لِهَمِّى وَوَحْشَتِى", "أُقَاسِى مَرِيرًا وَهْوَ عَيْنُ تَلَذُّذِى"],
      ["ذَرِينِي لِتَذْكَارِ الْأَمِينِ فَإِنَّهُ", "مَلَاالْقَلْبَ مَالِي نَحْوَ ذِكْرَاكِ مَنْفَذِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا أُلْفَى لِوَصْلِكَ كَالَّذِي"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا أَعْلُواْ عَلَى كُلِّ جِهْبِذِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ عَايَنُواْ نُورَ مَأْخَذِ"]
    ]
  }