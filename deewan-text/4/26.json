{
    "id": 26,
    "title": "حرف الظاء",
    "huruf": [
      ["ظَعَنْتُ إِلَى وَادِي الْحَبِيبِ الْمُبَهَّجِ", "مُحَمَّدٍ الْمَاحِي الضَّلَالِ الْمُسَرَّجِ"],
      ["بِكَاظِمَةٍ أَحْبَابُ قَلْبِي وَسَلْعِهَا", "وَوَادِي الْنَّقَى مَغْنَى الْكَرِيمِ الْمُتَوَّجِ"],
      ["فَهَلْ لِي مِنِ الْمَامٍ بِتِلْكَ وَلَيْتَنِي", "أُوَافِيكَ يَا مَنْ نَهْجُهُ الدَّهْرَ مَنْهَجِي"],
      ["أُوَافِي لَّذِى لَوْلَاهُ مَا ذَرَّ شَارِقٌ", "وَلَوْلَاهُ نُورُ الشَّمْسِ لَمْ يَتَبَلَّجِ"],
      ["نَبِيٌّ حَوَى مَا لَمْ يَنَلْهُ مُقَرَّبٌ", "وَلَا فِي بُيُوتِ الْحَيِّ بِالْمُتَوَلِّجِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَعِيشُ بِهَا دَهْرِي بِغَيْرِ مُزَعِّجِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَإِنِّي أَسِيرُ الْحُبِّ دُونَ تَغَنُّجِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً عَلَى طُولِ الْمَدَى لَمْ تُنَسَّجِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "عَلَى ذَالِكَ الْفَخْمِ الْمُهِيْبِ الْمُبَهَّجِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "عَلَى ذَالِكَ الْأَقْنَى الْأَزَجِّ وَأَبْلَجِ"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "وَمَنْ سَلَكُوا فِي الدِّينِ أَحْسَنَ مَنْهَجِ"]
    ]
  }