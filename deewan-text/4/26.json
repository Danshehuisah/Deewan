{
    "id": 26,
    "title": "حرف الغين",
    "huruf": [
      ["غَرَامِي دَعَانِي لِلْفُرَيْشِ وَرَابِغِ", "وَطَيْبَةِ خَيْرِ الْخَلْقِ مُعْطِى السَّوَابِغِ"],
      ["سَلَامٌ عَلَى بِيْرَيْ عَلِيٍّ وَرُوْمَةٍ", "فَمَنْ لِي بِكَاسٍ مِنْ بِضَاعَةِ سَابِغِ"],
      ["سَلَامٌ عَلَى زَرْقَاءِ عَيْنٍ وَقَدْ سَمَتْ", "عَلَى الْحُورِ وَاشَوْقِي لِسَلْعٍ وَرَابِغِ"],
      ["سَلَامٌ عَلَى قَبْرِ الْأَمِينِ وَرَوْضَةٍ", "تُرِيكَ ضِيَاءً يَزْدَرِي كُلَّ بَازِغِ"],
      ["سَلَامٌ عَلَى رَوْضِ الْبَقِيعِ فَإِنَّنِي", "يُوَدِّى سَلَامِي كُلُّ آتٍ وَبَالِغِ"],
      ["مَحَى حُبُّهَا حُبَّ الْقُرَى مِنْ خَوَاطِرِي", "فَمَا لِنْدَرَا ذَاتُ الشُّمُوعِ الْبَوَازِغِ"],
      ["وَذَالِكَ مِنْ حُبِّ الْحَبِيبِ فَحُبُّهُ", "مَتَى يُقْذَفَنْ فِي الْقَلْبِ أَعْظَمُ دَامِغِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَيُصْبِغُ قَلْبَ الْعَبْدِ مِنْ خَيْرِ صَابِغِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَتَسْتَاصِلُ الْأَعْدَاءَ مِنْ كُلِّ زَائِغِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَاُكْسَى كِسَى الْأَنْوَارِ مِنْ كُلِّ صَابِغِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ أَنْذَرُوا كُلَّ بَالِغِ"]
    ]
  }