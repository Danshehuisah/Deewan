{
    "id": 27,
    "title": "حرف الشين",
    "huruf": [
      ["شَهِدْتُ وَلَا أُلْفَى لِعَهْدِيَ أَنُكُثُ", "بِأَنِّي عَلَى حُبِّي لِأَحْمَدَ أَمْكُثُ"],
      ["اُحِبُّكَ حُبًَّا لَا يُكَيَّفُ اَمْرُهُ", "وَكُلَّ الَّذِى يَهْوَاكَ اَوْ مَنْ يُحَدِّثُ"],
      ["فَلَيْتِيَ اَلْقَى الْمُصْطَفَى الْقَرْمَ لَيْتَهُ", "عَلَى عِوَجِى دَهْرِى بِرُوعِيَ يَنْفُثُ"],
      ["بِحُبِّ رَسُولِ اللَّهِ سَادَتْ عَشِيرَتِى", "وَنَسْلِي وَمَنْ يَرْعَى ذِمَامِى وَيَمْكُثُ"],
      ["بِحُبِّ رَسُولِ اللَّهِ تَعْلُوا مَدِيْنَتِي", "عَلَى الْمُدْنِ وَالْأَمْصَارِ وَالْخَيْرُ يَحْدُثُ"],
      ["بِحُبِّ رَسُولِ اللَّهِ تَعْلُوا مَنَارَتِي", "مَنَارَاتِ مُلْكٍ عَهْدَكَ الدَّهْرَ يَنْكُثُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً تُضِيءُ الْقَبْرَ سَاعَةَ أُجْدَثُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ بِالْحَدِيثِ تَحَدَّثُوا"]
    ]
  }