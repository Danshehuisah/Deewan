{
    "id": 6,
    "title": "حرف الحاء",
    "huruf": [
      ["حَرِيصٌ عَلَى إِهْدَا الثَّنَا وَالْمَدَآئِحِ", "لِجَانِبِ مَنْ سُكْنَاهُ بَيْنَ جَوَانِحِي"],
      ["يُهَيِّجُ أَشْوَاقِي هِلَالُ رَبِيعِهِ", "رَبِيعُ الْمُزُونِ الْوَاكِفَاتِ الدَّوَالِحِ"],
      ["يُنَكِّأُ قَرْحًا كَانَ مِنْ قَبْلُ دَامِيًا", "وَلِمْ لَا وَشِمْنَا فِيهِ بَرْقَ الْمَرَابِحِ"],
      ["نَبِيٌّ عَظِيمُ الْخُلْقِ مِفْتَاحُ غَيْبِ مَنْ", "لَهُ الْأَمْرُ أَوْ لِلْحَقِّ كُلُّ الْمَفَاتِحِ"],
      ["تَخَلَّى عَنِ الْإِيمَانِ مَنْ لَيْسَ صَادِقًا", "عَلَى حُبِّهِ مِنْ كُلِّ غَادٍ وَرَآئِحِ"],
      ["كَذَا مُؤْثِرٌ شَيْئًا سِوَاهُ لَوَانَّهُ", "حُشَاشَةُ نَفْسِ الْمَرْءِ بَيْنَ الْجَوَانِحِ"],
      ["وَحُبُّ رَسُولِ اللَّهِ زَيْنٌ وَمَفْخَرٌ", "وَأَمْنٌ وَإِيمَانٌ وَنَابُ الْمَصَالِحِ"],
      ["فَحُبُّ رَسُولِ اللَّهِ مَالِي وَمَالِكِي", "وَبَيْعِي وَحَيْثِي وَهْوَ عَيْنُ مَرَابِحِ"],
      ["هُوَ الْحُسْنُ وَالْإِحْسَانُ مِنْهُ وَإِنَّهُ", "لَمَصْرِفُ حُبِّي ثُمَّ كُلِّ الْمَدَآئِحِ"],
      ["حَبَانِي مُرَادِي قَبْلَ عِلْمِي وَنَشْأَتِي", "فَمِنِّى نَوَالُ الْكُلِّ وَالْكُلُّ مَانِحِي"],
      ["طَوَيْتُ مَقَامَاتِ الرِّجَالِ بِحُبِّهِ", "دَنَا فَتَدَلَّى لِي بِرَغْمِ قَبَائِحِي"],
      ["وَأَتْحَفَنِى مَالَا أَبُوحُ بِسِرِّهِ", "بِسُكْرٍ وَصَحْوٍ عِنْدَ صَاحٍ وَصَائِحِ"],
      ["وَفِي الْحَجِّ يَوْمَ الْعِيدِ بِالْخَيْفِ مِنْ مِنًى", "جِهَارًا أَتَانِي الْمُصْطَفَى بِالْمَنَائِحِ"],
      ["وَإِنِّي لَتَعْرُونِي لِذِكْرَاهُ هِزَّةٌ", "لِحُسْنِ مُحَيًّا فَاتَ كُلَّ الْمَدَآئِحِ"],
      ["وَإِنِّي لَتَعْرُونِي لِذِكْرَاهُ هِزَّةٌ", "جَوَادٌ يُنَسِّى السُّحْبَ إِثْرَ اللَّوَاقِحِ"],
      ["وَإِنِّي لَتَعْرُونِي لِذِكْرَاهُ هِزَّةٌ", "بِعَرْفٍ يُنَسِّى كُلَّ طِيبٍ وَفَآئِحِ"],
      ["مَعَ الْحَقِّ حَالَاتُ الْأَمِينِ كَحَالَتِي", "مَعَ الْمُصْطَفَى الْمُخْتَارِ نُورِ الْأَبَاطِحِ"],
      ["يُوَحِّدُهُ وَالْحَقُّ يُهْدِى صَلَاتُهُ", "عَلَيْهِ وَأُهْدِي نَحْوَهُ بِمَدَائِحِ"],
      ["وَذَا الْمَدْحُ ذَاكَ الْحَمْدُ وَالشُّكْرُ حِينَمَا", "يَقِلُّ شَكُورٌ لِلْأَلَا وَالْمَنَآئِحِ"],
      ["لَكَ الْحَمْدُ حَمْدَ الذَّاتِ بِالذَّاتِ دَآئِمًا", "عَلَى أَحْمَدَ الْمُخْتَارِ أَفْضَلِ نَاصِحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَأَصْحَابِ النَّبِيِّ الْمَنَاصِحِ"]
 ]
  }