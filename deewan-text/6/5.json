{
    "id": 5,
    "title": "حرف الجيم",
    "huruf": [
      ["جِهَارًا لَقِيتُ الْمُصْطَفَى بِعُرُوجِي", "إِلَى اللَّهِ مِنْ ذَا الْكَوْنِ وَقْتَ خُرُوجِي"],
      ["جَلِيلًا جَمِيلًا كَامِلًا وَمُبَشِّرًا", "بِدَرْكِ مُرَادِ الْعَبْدِ وَقْتَ وَلُوجِي"],
      ["جَزِيلَ نَوَالٍ جَابِرًا جَامِعً هُدًى", "اَلُوذُ بِهِ فِي مَدْخَلِي وَخُرُوجِي"],
      ["جُبِلْتُ بِحُبِّ الْهَاشِمِيِّ وَإِنْ دَنَتْ", "مَرَابِعُهُ زَخْرَفْتُ كُلَّ نَسِيجِي"],
      ["جَفَانِي مَنَامِي حِينَ يَدْنُواْ رَبِيعُهُ", "أَيَا النَّفْسُ ؤُوبِي لِلْحَبِيبِ وَعُوجِي"],
      ["جَرَى الْقَلَمُ الْأَعْلَى بِحُكْمٍ لِحَاكِمٍ", "بِأَنِّى الْمُعَلَّى رَغْمَ كُلِّ عُلُوجِ"],
      ["رُجُوعِي مِنَ الْمَوْلَى لِأَحْمَدَ نَازِلًا", "إِلَى الْمَلَإِ الْأَعْلَى فُوَيْقَ بُرُوجِ"],
      ["كَأَنِّى بَرِيدُ السِّرِّ لِلْكُلِّ قَاذِفًا", "بِوَقْتِ هُبُوطِي مِثْلَ وَقْتِ عُرُوجِي"],
      ["تَلَقَّاهُ مِنِّي كُلُّ رُوحٍ مُجَرَّدٍ", "صَفَا وَقْتُهُمْ وَالْأَمْرُ غَيْرُ مَرِيجِ"],
      ["وَذَالِكَ مِنْ حُبِّ الْحَبِيبِ مُحَمَّدٍ", "حَبِيبٌ حَبَا الْإِحْسَانَ قَبْلَ بَهِيجِ"],
      ["فَمَنْ يَتَعَلَّقْ بِالْأَمِينِ مَحَبَّةً", "يَنَلْ كُلَّ مَا يَهْوَى بِشَمِّ أَرِيجِى"],
      ["مَحَبَّتُهُ قُوتِي وَأُنْسِي وَنُصْرَتِي", "وَدِرْعِي الَّذِي يَبْقَى بِدُونِ فُرُوجِ"],
      ["مُحَمَّدُ عَبْدُاللَّهِ سَيِّدُ خَلْقِهِ", "بِهِ تَهْتَدِي الْعَرْبَاءُ قَبْلَ زَنُوجِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "يُغَسِّلُ بِالْمَاءِ الْخَطَا وَالثَّلُوجِ"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "صَلَاةٌ وَتَسْلِيمٌ عِدَادَ بُرُوجِ"]
    ]
  }