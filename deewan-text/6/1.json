    "title": "حرف الألف",
    "huruf": [
      ["اُرِيْتُ بِخَيْرِ الْخَلْقِ خَيْرَ مَرَآءِ", "نَفَى الشَّكَّ وَالْأَسْوَا وَكُلَّ مِرَآءِ"],
      ["وَهَيَّجَ شَوْقِي وَالْمَحَبَّةَ وَالضَّنَا", "وَأَرَّقَنِي إِذْ نَامَ أَهْلُ خِبَآئِي"],
      ["يُؤَنِّسُنِي طِرْسِي وَنِقْسِي وَلَقْلَقِي", "جِهَارًا وَقَلْبِي أُنسُهُ بِشِفَآءِ"],
      ["مُحَمَّدُ مُخْتَارُ الْإِلَهِ نَبِيُّهُ", "عَلَيْهِ أَتَتْ آيَاتُهُ بِثَنَاءِ"],
      ["فَلَمْ أَقْفُ غَيْرَ الْمُصْطَفَى لَسْتُ تَالِيًا", "سِوَى ذِكْرِهِ كُفُّوا الْمَلَامَ مَلَائِي"],
      ["هَلِ الدِّينُ غَيْرُ الذِّكْرِ وَالسُّنَّةِ الَّتِي", "عَنِ الْمُصْطَفَى صَحَّتْ فَتِلْكَ دَوَآءِ"],
      ["أَنَصْبَ خِلَافٍ بَيْنَ طَاهَ وَغَيْرِهِ", "يَرَاهُ لَبِيبٌ غَيْرَ عَيْنَ عَمَآءِ"],
      ["أَيَا نَاسُ خَلُّوا الْهَزْلَ وَاقْفُوا مُحَمَّدًا", "وَإِلَّا تَرَوْا نِي الْدَّهْرَ جَدَّ بَرَآءِ"],
      ["مُحَمَّدُ خَيْرُ الْعَالَمِينَ مُحَمَّدٌ", "رَسُولٌ أَمِينٌ ذُو سَنًا وَسَنَآءِ"],
      ["فَصِيحٌ بَلِيغٌ لَيْسَ يَنْطِقُ عَنْ هَوَى", "بَلِ الْوَحْيِ وَالتَّنْزِيلِ وَحْيِ سَمَآءِ"],
      ["عَلَيْكُمْ بِحَبْلِ اللَّهِ لِلْعَبْدِ وَاثِقًا", "فَنَهْجُ يُنَاوِى الذِّكْرَ نَهْجَ شَقَآءِ"],
      ["وَإِنْ قُلْتَ هَلْ ذَا الْوِرْدُ نَهْجُ مُحَمَّدٍ", "أَقُولُ نَعَمْ وِرْدِي لِنَيْلِ صَفَآءِ"],
      ["فَمَا الْوِرْدُ إِلَّا الذِّكْرُ لِلَّهِ وَحْدَهُ", "تُصَلِّي عَلَى الْمُخْتَارِ خَيْرِ وَرَآءِ"],
      ["فَمَا فِيهِ ذِكْرُ الشَّيْخِ أَوْ ذِكْرُ غَيْرِهِ", "فَوِرْدِي لِدَآءِ الْعَبْدِ عَيْنُ دَوَآءِ"],
      ["رُوَيْدَكُمُ لَا تُنْكِرُواْ عَنْ جَهَالَةٍ", "لِبَغْيٍ وَعُدْوَانٍ وَعَيْنِ جَفَآءِ"],
      ["فَقَدْ بَلَّغَ الْهَادِي وَأَدَّى أَمَانَةً", "حَذَا حَذْوَهُ الْهَادُونَ شُهْبُ دُجَآءِ"],
      ["وَالْأَعْلَامُ قَادَاتٌ بِقَفْوِ نَبِيِّنَا", "لِتَقْفُوا الَّذِي يَقْفُوهُ دُونَ مِرَآءِ"],
      ["سَوَاءٌ جَلِيلٌ أَوْ حَقِيرٌ فَمَا لَنَا", "سِوَى قَفْوِهِ دَهْرًا صَبَاحَ مَسَآءِ"],
      ["أَيَا رَبَّ جِبْرِيلَ الْأَمِينِ فَثَبِّتَنْ", "عَلَى سُنَّةِ الْهَادِي قُلُوبَ أُولَاءِ"],
      ["وَلَا يَبْتَلِينَا اللَّهُ بِالزَّيْغِ وَالْهَوَى", "نَعِيشُ عَلَى الْبَيْضَا لِيَوْمِ لِقَآءِ"],
      ["وَلَا يَكُ قِشْرُ الدِّينِ حَظَّ مُحِبِّنَا", "بَلِ اللُّبُّ لُبُّ اللُّبِّ مَحْضَ عَطَآءِ"],
      ["سَرَى طَيْفُهُ وَهْنًا وَكِدْتُ لِحُبِّهِ", "أَطِيرُ اشْتِيَاقًا وَالْغَرَامُ بَلَآءِ"],
      ["وَكُلٌّ وَلَيلَاهُ وَبَرْهَامُ مُبْتَلًى", "بِأَحْمَدَ خَيْرِ النَّاسِ عَيْنِ بَهَآءِ"],
      ["وَمِنْ حَسَدٍ جَارُواْ عَلَيَّ وَإِنَّنِي", "مُبَرِّزُ اَقْرَانِي أَوَانَ صِبَآءِ"],
      ["وَقَدْ تَمَّ فَتْحِي عِنْدَ مَهْدِي وَقَدْ عَنَتْ", "جَمِيعُ رِجَالِ الْغَيْبِ تَحْتَ قَضَآءِ"],
      ["فَمَا قَطَعُواْ فِي الشَّرْقِ وَالْغَرْبِ فَدْفَدًا", "إِلَى مَكَّةٍ إِلَّا لِشَمِّ شَذَآءِ"],
      ["وَلِمْ لَا وَعَيْنِي الْيَوْمَ عَيْنُ مُحَمَّدٍ", "سَرَى سِرُّهُ فِي هَيْكَلِي وَرُوَآئِي"],
      ["وَأَهْلُ زَمَانِي كُلُّهُمْ فَازَ رَاقِيًا", "سِوَى مَنْ قَلَا نَهْجِي أَسِيرَ هَوَآءِ"],
      ["وَمَا قُلْتُهُ شَطْحًا وَدَعْوَى عَرِيضَةً", "وَهَبْتُ جَمِيعَ الْفَائِزِينَ وَلَائِى"],
      ["وَبِي يُرْفَعُ الْجَوْزُ الْعَظِيمُ وَإِنَّهُ", "بِفَيْضِي يَنَالُ الدِّينُ رَفْعَ لِوَآءِ"],
      ["وَمَنْ شَاءَ يَاتِيهِ قُبَيْلَ مَمَاتِهِ", "وَمَنْ شَاءَ نَاوَاهُ كَأَهْلِ شَقَآءِ"],
      ["وَمَنْ رَامَ إِطْفَاءً لِنُورِ إِلَهِنَا", "أَبَى اللَّهُ أَنْ يُطْفِيهِ رَغْمَ عِدَآءِ"],
      ["سَاُرْغِمُ بِالْمَاحِي الضَّلَالِ اَنُوفَ مَنْ", "يَرَى الشِّرْكَ وَالتَّثْلِيثَ أَهْلَ قِلَآءِ"],
      ["هَدَمْتُ الَّذِي قَدْ أَسَّسُوهُ وَإِنَّنِي", "بِسِرِّ الْمُقَفَّى لَا يُحَدُّ بِنَآءِ"],
      ["رَمَوْنِي وَمَا نَالُوا مُرَادًا وَإِنَّنِي", "أُمَزِّقُ بِالْمَاحِي جُمُوعَ عِدَآئِي"],
      ["سَيُهْزَمُ هَاذَا الْجَمْعُ حَقًّا وَإِنَّهُمْ", "يُوَلُّونَ أَدْبَارًا رِقَابَ إِمَآءِ"],
      ["يَسُومُونَ ضَيْمًا لِلْخَدِيمِ وَإِنَّهُ", "تَتَرَّسَ بِالْمُخْتَارِ قَبْلَ رِمَآءِ"],
      ["أَيُخْشَى عَلَى جَارِ الْأَمِينِ حَدِيمِهِ", "مَكَائِدَ أَبْنَاءِ لِأَهْلِ بَغَآءِ"],
      ["وَقَدْ زَخْرَفَ الْأَقْوَامُ مَكْرًا بِنَدْوَةٍ", "وَخَطُّوا كِتَابًا قَصْدَ دَفْعِ ضِيَآءِ"],
      ["وَجَاءُواْ بِبَدْرٍ خَيْلُهُمْ وَرِجَالُهُمْ", "وَبَاؤُاْ بِخِزْيٍ ظَاهِرٍ وَوَبَآءِ"],
      ["وَهَلْ مَنَعُواْ الْمَاحِي الطَّوَافَ بِبَيْتِهِ", "بِمَكَّةَ يَوْمَ الْفَتْحِ وَقْتَ ضُحَآءِ"],
      ["وَهَلْ مَنَعُوا نَشْرَ الدِّيَانَةِ دَآئِمًا", "بِكُلِّ بِلَادِ اللَّهِ طُولَ بَقَآءِ"],
      ["صَلَاةٌ وَتَسْلِيمٌ عَلَيْهِ بِقَدْرِهِ", "وَآلٍ وَأَصْحَابٍ وَأَهْلِ وَلَآءِ"]
    ]
