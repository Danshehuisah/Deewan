{
    "id": 19,
    "title": "حرف الغين",
    "huruf": [
      ["غَدًى أَتَخَلَّى عَنْ هُمُومٍ اُبَلِّغُ", "مَدِيحَ حَبِيبِى وَهْيَ نَعْمَايَ تُسْبَغُ"],
      ["غَرَامِي جَمِيعًا لِلْمَدِينَةِ إِذْ نَأَتْ", "دِيَارِي فَهَلْ يَا قَدْ تَرَانِى اُبَلِّغُ"],
      ["غِنَايَ بِهَا عَيْشِي بِهَا لَذَّتِي بِهَا", "أَتَاهَا رَسُولُ الْعَالَمِينَ الْمَبَلِّغُ"],
      ["غَلِيلِيَ لَا يُرْوَى بِغَيْرِ مَعِينِهَا", "وَإِنَّ شِفَائِي تُرْبُهَا إِذْ أُمَرِّغُ"],
      ["غَوَى وَعَدَى مَنْ قَدْ يَلُومُ بِحُبِّهَا", "وَأَقْذِفُهُ بِالْحَقِّ فِي الْحِينِ يَدْمَغُ"],
      ["غُرُورٌ هَوًى يَدْعُوا لِرَفْعِ سِوَائِهَا", "فَلَيْتَ فُؤَادِي فِي هَوَى تِلْكَ يُصْبَغُ"],
      ["عَلَى سَاكِنِي وَادِي الْعَقِيقِ تَحِيَّتِي", "وَإِنْ أَسْهَرُونِي وَالْمَدَامِعَ فَرَّعُوا"],
      ["عَلَى أَحْمَدَ الْمُخْتَارِ مِنْ عِنْدِ رَبِّهِ", "صَلَاةٌ وَتَسْلِيمٌ مِنَ اللَّهِ مَبْلَغُ"]
    ]
  }