{
    "id": 26,
    "title": "حرف الهاء",
    "huruf": [
      ["هُوَ الْهَدْيُ هَدْيُ الْمُصْطَفَى وَسِوَاهُ", "هَوًى وَضَلَالٌ لَا تَقُدْ بِبُرَاهُ"],
      ["فَوَحْيٌ مِنَ اللَّهِ الْجَلِيلِ جَلَالُهُ", "عَلَى أَكْمَلِ الْأَرْسَالِ وَهْوَ تَلَاهُ"],
      ["وَبَيَّنَهُ إِذْ لَا مُبِينَ شَرِيعَةً", "لِذَا الْوَحْيِ غَيْرُ الْمُصْطَفَى وَهُدَاهُ"],
      ["أُحِبُّ الرَّسُولَ الْمُصْطَفَى الْقَرْمَ إِنَّهُ", "تَشَرَّبَ قَلْبِي حُبُّهُ وَهَوَاهُ"],
      ["وَلِمْ لَا وَعَيْنِي قَدْ رَأَتْهُ بِحَيِّ مَنْ", "أُحِبُّ وَأَهْوَى عَيْنَهُ وَثِنَاهُ"],
      ["تَجَلَّتْ لَهُ الذَّاتُ الْعَلِيَّةُ قَبْلَ مَا", "رَأَتْ غَيْرَهُ إِذْ مَا هُنَاكَ عَدَاهُ"],
      ["فَأَوَّلُ مَحْبُوبٍ وَأَوَّلُ ذَاكِرٍ", "وَأَوَّلُ مَذْكُورٍ أُنِيلُ لِقَاهُ"],
      ["فَقَامَ يَذُودُ الْغَيْرَ حُبًّا وَغِيْرَةً", "يَقُولُ فَمَا غَيْرِي يَشَمُّ شَذَاهُ"],
      ["فَمَنْعٌ عَطًا بُعْدٌ وَقُرْبٌ حِجَابُهُ", "زَوَالُ حِجَابٍ فَاسْتَنِرْ بِسَنَاهُ"],
      ["فَمَهْمَا يَقُلْ لَا لَا سَبِيلَ لِوَصْلِ مَنْ", "تُحِبُّ فَقُلْ لَا لَا أَرَاكَ سِوَاهُ"],
      ["فَأَنْتَ مُرَادُ الْكُلِّ وَالْكُلُّ وَاصِلٌ", "فَمَهْمَى دَرَاكَ الْعَبْدُ نَالَ مُنَاهُ"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَأَصْحَابٍ عَلَوْا بِعُلَاهُ"]
    ]
  }