{
    "id": 28,
    "title": "حرف الياء",
    "huruf": [
      ["يَقِينِي يَقِينِي رَائِحًا فِيكَ غَادِيَا", "عَلَى رَغْمِ قَالٍ لِلدِّيَانَةِ عَادِيَا"],
      ["يَمِينِي وَخَلْفِي أَحْمَدُ النُّورُ مُرْشِدِي", "إِمَامِي أَمَامِي مُهْلِكُ الْكُفْرِ مَاحِيَا"],
      ["يَسَارِي يُسَارِي مُصْطَفَى الْكَوْنِ مَسْنَدِي", "فَمَنْ كَادَنِي يَلْقَ الرَّدَى وَالْمَخَازِيَا"],
      ["يُؤَمِّنُنِي دُنْيًا وَأُخْرًى فَأَقْتَفِي", "مَنَاهِجَهُ بِالرُّوحِ لِلَّهِ سَارِيًا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "سَمِيرِي كِتَابُ اللَّهِ فِي اللَّيْلِ تَالِيَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُجِيبُ أَيَا الْمَوْلَى جَمِيعَ دُعَآئِيَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِأَبْقَى أُشِيدُ الدِّينَ فِي الْجَوِّ بَانِيَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أُدَمِّرُ بِالْمَاحِي جُمُوعَ عِدَآئِيَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ شَيَّدُواالدِّينَ عَالِيَا"]
    ]
  }