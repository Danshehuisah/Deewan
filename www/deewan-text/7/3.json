{
    "id": 3,
    "title": "حرف الجيم",
    "huruf": [
      ["جَزَى اللَّهُ رَبُّ النَّاسِ خَيْرًا مُحَمَّدًا", "وَيَالَيْتَ شِعْرِي مَا أَرُومُ لِأَحْمَدَا"],
      ["فَأَفْضَلُ خَلْقِ اللَّهِ طُرًّا مُحَمَّدُ", "وَأَكْرَمُهُمْ نَفْسًا وَصِهْرًا وَمَحْتِدَا"],
      ["وَأَحْسَنُهُمْ خَلْقًا وَخُلْقًا وَمَنْطِقًا", "وَأَكْرَمُهُمْ قَوْمًا وَأَنْدَى وَأَجْوَدَا"],
      ["وَأَطْهَرُ خَلْقِ اللَّهِ جِسْمًا وَمَلْبَسًا", "وَأَطْيَبُهُمْ حَيًّا وَمَيْتًا وَأَفْيَدَا"],
      ["وَأَرْحَمُ فِي الدُّنْيَا وَالْأُخْرَى وَاِنَّهُ", "شَفِيعُ الْوَرَى وَالْكُلُّ لِلْخَوْفِ أَرْعَدَا"],
      ["فَكُلٌّ بَرِيءٌ قَالَ نَفْسِي وَأُمَّتِي", "يَقُولُ وَيَدْنُو حَامِدًا وَمُحَمَّدَا"],
      ["وَأَيْنَ خَلِيلُ اللَّهِ أَيْنَ كَلِيمُهُ", "حَبِيبِي حَبِيبُ اللَّهِ مُعْطِي الْوَرَى الْجَدَا"],
      ["وَأَيْنَ صَفِيُّ اللَّهِ وَالرُّوحُ رُوحُهُ", "وَأَفْضَلُ طَاهَ الْهَاشِمِيُّ تَغَمَّدَا"],
      ["وَأَدْعُوكَ خَيْرَ الرُّسْلِ سَيِّدُ خَلْقِهِ", "عَلَيْكَ صَلَاةُ اللَّهِ أَفْضَلُ مَنْ هَدَى"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةٌ وَتَسْلِيمٌ يَقُودَانِ لِلْهُدَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أُحِبُّكَ شَخْصًا قَبْلَ أَنْ تُجْزِلَ النَّدَى"],
      ["بِكَولَخِ وَهْنًا قَدْ أَرِقْتُ لِذِكْرِهِ", "وَقَدْ نَامَ جَارَاتِي وَحُبِّي تَوَقُّدَا"],
      ["أُسَامِرُهُ لَيْلِي وَقَدْ حَالَ دُونَهُ", "مَهَامِهُ أَطْوِي فَدْفَدًا ثُمَّ فَدْفَدَا"],
      ["أَطِيرُ بِهِ مِنْهُ لَهُ مُتَرَنِّمَا", "سَرَيْنَا وَنَجْمٌ قَدْ أَضَاءَ فَمُذْ بَدَا"],
      ["بِرُوحِيَ لَا رُوْحِى وَجِسْمِي وَلَيْتَنِي", "بِجِسْمِيَ فِي دُورِي أَتَيْتُ مُحَمَّدَا"],
      ["أُوَاجِهُ طَاهَ الْهَاشِمِيَّ بِبَيْتِهِ", "أُبَلِّغُهُ تَسْلِيمَ قَوْمِي الْأُولَى هَدَى"],
      ["أَنَالُ مَرَامِي فَوْقَ مَا كُنْتُ آمِلًا", "إِذَا طِرْتُ لِلْهَادِي الَّذِى الْكُلَّ أَرْشَدَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِتَقْبَلَ بُنْيَانِي وَتُبْقِيهِ مَسْجِدَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِتَرْفَعَ مَنْ يُعْلِي بِنَاهُ وَتُسْعِدَا"],
      ["وَيَاوِي لَهُ كُلُّ الْمَسَاجِدِ وَاحْمِهِ", "مِنَ الْمُحْدَثَاتِ السُّوْءِ لِذِّكْرِ سَرْمَدَا"],
      ["وَتَجْمَعُ فِيهِ الْخَيْرَ وَالْعِلْمَ وَالتُّقَى", "إِلَى أَبَدِ الْآبَادِ لَمْ يَلْقَ مَلْحَدَا"],
      ["يَسِيرُ بِنَا نَحْوَ التَّقَدُّمِ دَائِمًا", "بِدِينٍ وَدُنْيًا بَاهِرِ السِّرِّ مُفْرَدَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "مَدِينَةُ تَبْقَى مَعْقَلَ الْأَمْنِ وَالْهُدَى"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ كُلِّهِمْ لِيَ مُقْتَدَى"]
    ]
  }