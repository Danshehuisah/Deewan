    "title": "حرف الطاء",
    "huruf": [
      ["طَوَى لِى رَسُولُ اللَّهِ وَهْوَ مُشَيِّعِى", "وَقَدْنَالَنِي  مَاكَانَ جِدًّا مُمَنَّعِ"],
      ["طَفَى كُلَّ نَارٍ أَوْقَدُوهَا عَدَاوَةً", "لِخَادِمِهِ فَالْكُلُّ أَيُّ مُضَيَّعِ"],
      ["طَبَانِي وِدَادُ الْمُنْحَمِنَّا وَقَادَنِي", "غَرَامِي لَهُ وَالْخَلْقُ مِنْهُ مُسَجَّعِ"],
      ["طَبِيبٌ كَرِيمٌ رَاحِمٌ وَهْوَ نَافِعٌ", "وَسِيلَةُ كُلُّ النَّاسِ فِي كُلِّ مَوْقِعِ"],
