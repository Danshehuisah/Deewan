      ["وَعُثْمَانُ ذُو النُّورَيْنِ وَاعِي كَلَامَهُ", "وَجَامِعَهُ إِذْلَاتَ حِينَ مُجَمَّعِ"],
      ["كَذَالصِّنْوُ وَالصِّهْرُ الْمُفَخَّمُ بَابُهُ", "عَلِيُّ وَلِيُّ الْحَقِّ حِصْنِي الْمُمَنَّعِ"],
      ["وَطَلْحَةُ سَعْدٌ وَالزُّبَيْرُ سَعِيدُنَا", "وَنَجْلُ جَرَاحٍ وَابْنُ عَوْفِ الْمُقَنَّعِ"],
