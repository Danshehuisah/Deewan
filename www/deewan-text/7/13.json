{
    "id": 13,
    "title": "حرف الميم",
    "huruf": [
      ["مُرَادِيَ عَيْنُ الْحَقِّ تَيْدَكَ لَائِمِى", "فَلَيْسَ سِوَى الذِّكْرِ الْحَكِيمِ بِعَاصِمِ"],
      ["تَلَاهُ الْفَتَى الْمَأْمُونُ مِنْ عِنْدِ رَبِّهِ", "مِنِ امْلَاءِ جَبْرَائِيلَ أَكْبَرِ خَادِمِ"],
      ["فَجَاءَ بِهِ نُورًا دَعَانَا لِرَبِّهِ", "وَأَبْلَغْنَا مَا فَاتَ كُلَّ الْعَوَالِمِ"],
      ["وَصِرْنَا بِهِ خَيْرَ الْبَرَايَا وَإِنَّنَا", "شُهُودٌ إِذَا يَقْضِى الْمُهَيْمِنُ رَاحِمِي"],
      ["لَنَا شَاهِدٌ عَدْلٌ مُزَكًّى مُبَرِّزٌ", "وَيَرْفَعُنَا فَوْقَ السُّهَى وَالنَّعَائِمِ"],
      ["وَذَا الْمُنْحَمِنَّا مَلْجَأَ الْكُلِّ شَافِعًا", "لِوَا الْحَمْدِ فِي كَفَّيْهِ هَلْ مِنْ مُزَاحِمِ"],
      ["فَأَنْشُدُ أَمْدَاحِي وَأَشْدُواْ بِذِكْرِهِ", "جِهَارًا عَلَى رَغْمِ الْعَدُوِّ الْمُسَاخِمِ"],
      ["فَأَشْرَبُ مِنْ كَفِّ الْأَمِينِ وَإِنَّنِي", "أُسَاقِي بِيُمْنِ الْهَاشِمِيِّ مُلَائِمِي"],
      ["وَمَنْ قَالَ قَدْ أَضْلَلْتُ فَالْحَقُّ شَاهِدٌ", "عَلَى أَنَّنِي مَا حِدْتُ عَنْ نَهْجِ هَاشِمِ"],
      ["وَذَاالدِّينُ مَوْرُوثٌ بِعِلْمٍ فَلَمْ يَرِثْ", "أَخُو الْجَهْلِ نِحْرِيْرًا سَلِيلَ الْأَكَارِمِ"],
      ["وَإِنْ ضَلَّلَ الْجُهَّالُ ذَاالْعِلْمِ وَالْهُدَى", "فَتَفْسِيرُهُ ذُو الْجَهْلِ لَيْسَ بِعَالِمِ"],
      ["بِكَسْبٍ يَكُونُ الْإِرْثُ عِنْدَ نَبِيِّنَا", "عَلَيْهِ صَلَاةُ اللَّهِ عَدَّ الْعَوَالِمِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَأَصْحَابٍ بُحُورِ الْخَضَارِمِ"]
    ]
  }