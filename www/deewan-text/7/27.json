{
    "id": 27,
    "title": "حرف الغين",
    "huruf": [
      ["غَنَائِمُ بِرٍّ أَقْبَلَتْ فَلْتُبَالِغُوا", "بِإِعْدَادِ إِخْلَاصٍ تُصِبْكُمْ سَوَابِغُ"],
      ["سَوَابِغُ آلَاءٍ بِبَطْنٍ وَظَاهِرٍ", "وَيُتْحِفُهَا بَرٌّ رَءُوفٌ وَبَالِغُ"],
      ["بِيُمْنِ حَبِيبِي خَاتِمِ الرُّسْلِ نَاصِرٍ", "مُحَمَّدٍ الْمَاحِي الضَّلَالِ الْمُبَالِغُ"],
      ["مُوَطِّدُهَا ذَالدِّينَ بِالْعَزْمِ وَالتُّقَى", "وَقَدْ أَشْرَقَ الْأَرْجَا وَضَاءَ الْبَوَازِغُ"],
      ["يُسَاعِدُهُ رَبُّ الْعِبَادِ وَإِنَّهُ", "كَرِيمٌ وَهُوبٌ بَذْلُهُ الدَّهْرَ سَائِغُ"],
      ["يُئَيِّدُهُ رَبُّ الْعِبَادِ وَإِنَّهُ", "لَثَبْتُ جَنَانٍ لِلْأَبَاطِلِ دَامِغُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَتَاكَ كَئِيبٌ قَلْبُهُ الْيَوْمَ فَارِغُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَهَلْ يُدْرِكُ ضَّلِّيعَ فِي الشَّأْوِ صَالِغُ"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "وَمَنْ تَابَعُوا نَهْجَ الْأَمِينِ وَبَالَغُواْ"]
    ]
  }