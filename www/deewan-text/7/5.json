{
    "id": 5,
    "title": "حرف الهاء",
    "huruf": [
      ["هُدَى الْمُنْحَمِنَّا مُعْجِبِى لَسْتُ أَعْجَبُ", "لِشَيْءٍ مِنَ الْأَشْيَا سِوَاهُ وَأَرْغَبُ"],
      ["رَسُولٌ سُمَاهُ صَادِقٌ لَيْسَ نَاطِقًا", "بِشَيْءٍ سِوَى وَحْيِ الْإِلَاهِ وَيُعْرِبُ"],
      ["فَحَقٌّ يَقِينٌ مَا سِوَاهُ مُشَكَّكٌ", "وَمُحْتَمِلٌ تَحْقِيقُهُ الدَّهْرَ يُتْعِبُ"],
      ["فَمَنْ لِسِوَى الْهَادِي يَرُومُ قِيَادَتِي", "فَذَاكَ الْمُعَنَّى وَهْوَ أَشْقَى وَأَخْيَبُ"],
      ["فَلَمْ أَرْضَ تَغْيِيرًا وَلَسْتُ مُبَدِّلًا", "فَمَذْهَبُ غَيرِ الْهَاشِمِي لَسْتُ أَذْهَبُ"],
      ["وَنَهْجُ سَبِيلِي وَاضِحٌ لِمَنِ اهْتَدَى", "وَقَدْ خَابَ مَنْ يَبْغِي اِعْوِجَاجِي وَيَطْلُبُ"],
      ["عَلَى السَّلَفِ الْأَعْلَامِ رِضْوَانُ رَبِّهِمْ", "فَقَدْ دَرَّسُوا نَهْجَ الْأَمِينِ وَهَذَّبُوا"],
      ["وَلَيْسَ لَهُمْ شَيْءٌ سِوَى قَفْوِ أَحْمَدٍ", "وَلَيْسَ لَنَا بَلْهَ ابْتِدَاعًا يُعَقَّبُ"],
      ["عَلَى ذَادَرَجْنَا لَا مَلَامَ فَكُلُّنَا", "عَلَيْهِ اخْتِيَارٌ كَيْفَ يَنْحُوا وَيَذْهَبُ"],
      ["أَلَا فَشْهَدُوا أَنِّي أُحِبُّ مُحَمَّدًا", "وَأَبْغَضُ كُفْرَانًا كَنَارٍ تَلَهَّبُ"],
      ["أَحَبُّ إِلَيَّ مِنْ وَلِيدِي وَوَالِدِي", "وَنَفْسِي وَأَهْلِي بَلْهَ مَالِي سَيُحْسَبُ"],
      ["أُحِبُّ لِذَاتِ اللَّهِ حَقًّا وَإِنَّنِي", "حَلَالِيَ إِيمَانِي وَنَهْجِي مُهَذَّبُ"],
      ["فَإِنْ فَاخَرَ الْأَقْوَامُ حَقًّا وَإِنَّنِي", "أُفَاخِرُ بِالْهَادِي الْأَمِينِ وَأَطْرَبُ"],
      ["وَرَبِّي وَرَبِّي اللَّهُ حَقًّا فَلَمْ أَقِفْ", "لِتَهْدِيدِ جَبَّارٍ حَجًا يَتَقَلَّبُ"],
      ["فَلَمْ أَرْجُ مَخْلُوقًا وَلَسْتُ بِطَامِعٍ", "فِي شَخْصٍ سِوَى شَخْصٍ لِرَبِّيَ يُقْرِبُ"],
      ["وُقُوفِي لَدَى بَابِ الْمُهَيْمِنِ دَائِمًا", "وَفَقْرِي إِلَيْهِ لَا لِمَلْكٍ يُحَجَّبُ"],
      ["غَنِيتُ بِهِ يَكْفِي لِفَقْرِي وَفَاقَتِي", "يَلِينُ الْقَوَاسِي وَهْوَ مَغْنَايَ يُخْصِبُ"],
      ["وَيُدْنِي بَعِيدًا وَالْمَنَالَ يُنِيلُهُ", "فَأَفْضَلُ مَنْ يُعْلِي وَمَنْ قَدْ يُرَتَّبُ"],
      ["صَلَاةٌ وَتَسْلِيمٌ عَلَى خَيْرِ هَاشِمٍ", "مَعَ الْآلِ طُرًّا ثُمَّ مَنْ كَانَ يَصْحَبُ"]
    ]
  }