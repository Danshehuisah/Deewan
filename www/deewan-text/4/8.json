{
    "id": 8,
    "title": "حرف الحاء",
    "huruf": [
      ["حِمَايَةُ هَاذَا الْعَبْدِ مِنْ كُلِّ حَائِمِ", "مَحَبَّةُ خَيْرِ الْخَلْقِ مَأْوَى الْأَكَارِمِ"],
      ["هُوَ الْبَحْرُ وَاللَّيْثُ الْجَسُورُ شَجَاعَةً", "وَجُودًا فَخَيْرُ الْخَلْقِ بَحْرُ الْمَكَارِمِ"],
      ["هُوَ الشَّمْسُ وَالْغَيْثُ الْمَرِيعُ هِدَايَةً", "وَبَذْلًا وَبَلْهَ الْغَيْثَ غَيْرُ مُدَاوِمِ"],
      ["فَسَاسَ جَمِيعَ الْعُرْبِ وَالْعُجْمِ كُلِّهَا", "فَعَمَّ هُدَاهُ الْيَوْمَ كُلَّ الْأَقَالِمِ"],
      ["وَشَتَّتَ شَمْلَ الْمُشْرِكِينَ وَقَدْ عَلَا", "بِسَطْوَتِهِ الْتَّوحِيدُ دُونَ مُزَاحِمِ"],
      ["إِمَامً كَرِيمً مُنْصِفًا وَمُقَوِّمًا", "أَدِيبًا مَهِيبًا مُحْسِنًا لِلْمُسَاخِمِ"],
      ["جَمِيلًا جَلِيلًا مُنْفِقًا مُتَوَاضِعًا", "وَلَمْ يَكُ فَظًّا لَا وَلَيْسَ بِظَالِمِ"],
      ["وَقَدْ كَانَ مَنْصُورًا بِرُعْبٍ فَصَحْبُهُ", "بِهِ دَوَّخُوا الْبُلْدَانَ لَا بِالصَّوَارِمِ"],
      ["فَيَا لَيْتَهُ قَوَّى الْعُبَيدَ وَصَحْبَهُ", "لِنُدْرِكَ ثَأْرًا مِنْ عَدُوٍّ وَغَاشِمِ"],
      ["وَيُعْلِي بِنَا التَّوْحِيدَ حَقًّا بِسُرْعَةٍ", "وَيُعْنِي ذَوِي الْحَاجَاتِ مِنْ كُلِّ رَائِمِ"],
      ["بِجَاهِ رَسُولِ اللَّهِ ثُمَّ صِحَابِهِ", "فَيَعْلُو مَنَارُ الدِّينِ فَوْقَ الْمَعَالِمِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِكَيْ لَا يَعِيشَ الْعَبْدُ عَيْشَ الْبَهَآئِمِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَلِي شَهْوَةٌ فِي ذِكْرِ تَسْلِيمِ هَاشِمِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَقَدْ حَيَّرَ الْمُخْتَارُ أَفْكَارَ عَالَمِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَلِي سَكْرَةٌ تَفْنَى لَدَيْهَا عَوَالِمِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "بِهَا أَرْتَقِي لِلْحُبِّ أَقْصَى السَّلَالِمِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "مَعَ الْآلِ وَالصَّحْبِ الْبُحُورِ الْخَضَارِمِ"]
    ]
  }