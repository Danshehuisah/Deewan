{
    "id": 17,
    "title": "حرف الفاء",
    "huruf": [
      ["فَهَلْ لَكَ أَنْ تَنْحُوَاْ اْلِنَحْوِ الْمُؤَسِّسِ", "مُحَمَّدٍ الْمَاحِي حَبِيبِي الْمُقَدَّسِ"],
      ["أُنَادِيهِ يَا طَاهَ وَأَحْمَدُ عَاقِبًا", "وَحَاشِرُ يَا هَادِي الْعِبَادِ الْمُؤَسِّسِ"],
      ["مُحَمَّدُ مَحْمُودٌ مُحَمَّدُ حَامِدٌ", "مُحَمَّدٌ الْمُخْتَارُ مَاحِي الْعَرَنْدَسِ"],
      ["هُوَ الْمُصْطَفَى الْمَحْبُوبُ وَهْوَ الْمُزَمِّلُ الْـ", "ـمُدَثِّرُ يَاسِينُ عَلَا كُلَّ أَقْدَسِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً تُنِيلُ الْعَبْدَ كُلَّ تَقَدُّسِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَاَلْمَسُ قُرْبَ الْمُقْتَفَى كُلَّ مَلْمَسِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ تَزْدَرِي كُلَّ نَرْجَسِ"]
    ]
  }