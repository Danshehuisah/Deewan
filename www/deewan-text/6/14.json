{
    "id": 14,
    "title": "حرف الصاد",
    "huruf": [
      ["صَفَا لِيَ وَقْتِي وَالْحَبِيبُ يُخَصِّصُ", "وَإِنِّيَ مَحْبُوبٌ لِطَاهَ مُخَصَّصُ"],
      ["مُرَادٌ لِحَمْلِ السِّرِّ مِنْ قَبْلِ نَشْأَتِي", "مُرَبٍّ لِكُلِّ الْعَارِفِينَ وَمُخْلِصُ"],
      ["وَإِنْ دَهِشَ الْأَقْطَابُ يَوْمًا بِمَشْهَدٍ", "رَأَوْنِيَ وَانْقَادُوا إِلَيَّ وَأَخْلَصُوا"],
      ["رَأَيْتُ رَسُولَ اللَّهِ نَصَّ بِأَنَّنِي", "سَفِيرٌ لَهُ فِي الْكَآئِنَاتِ مُخَلِّصُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَأَصْحَابٍ سَمَوْا وَتَخَصَّصُوا"]
    ]
  }