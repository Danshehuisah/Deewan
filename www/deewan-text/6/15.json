{
    "id": 15,
    "title": "حرف الضاد",
    "huruf": [
      ["ضَمِنْتُ لَهُ وَهِيَ الْنُّذُورُ فُرُوضُ", "يُوَافِيهِ مِنِّي بِالثَّنَآءِ قَرِيضُ"],
      ["وَذَاكَ رَسُولُ اللَّهِ أَحْمَدَ سَيِّدِي", "لِقَلْبِي لَدَى ذِكْرِ الْأَمِينِ نُهُوضُ"],
      ["نَهَضْتُ بِهِ مِنْهُ إِلَى اللَّهِ رَاحِلًا", "حَبَانِى وَلَا نَفْلٌ وَلَيْسَ فُرُوضُ"],
      ["وَهَلْ أَبْصَرَتْ عَيْنَاكَ مِثْلِيَ سَائِرًا", "سُلُوكِي وَجَذْبِي وَالْعُلُومُ فُيُوضُ"],
      ["كَفَانِيَ فِي سَيْرِ الْعَنَاءُ وَقَادَنِي", "إِلَى الذَّاتِ لَا نَجْدٌ عَرَا أَوْ حَضِيضُ"],
      ["وَكَشْفِيَ فِي الْأَسْمَاءِ وَالذِّكْرِ لَمْ أَحِضْ", "حَيَاتِي إِذَا بَعْضُ الرِّجَالِ يَحِيضُ"],
      ["وَسِرِّي سَرَى فِي الْخَافِقَيْنِ وَعُقِّمَتْ", "شُيُوخٌ عَلَوْا حَتَّى يَحُولَ جَرِيضُ"],
      ["عَلَى ذَالِكَ الْمَحْبُوبِ كَهْفِي وَمُرْشِدِي", "صَلَاةً بِهَا قَلْبِي أَرَاهُ رَحِيضُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا عَنَّا الزَّمَانُ غَضِيضُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "مَدَى الدَّهْرِ مَا دَمْعُ الْمُحِبِّ يَفِيضُ"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "مَنَاسِكُ شِعْرِي فِي ثَنَاكَ تَفِيضُ"]
    ]
  }