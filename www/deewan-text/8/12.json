{
    "id": 12,
    "title": "حرف اللام",
    "huruf": [
      [  "لِطَهَ نَبِيِّ الْأَنْبِيَاءِ ثَنَآئِي", "بِوَقْتِ اقْتِرَابِي مِثْلَ وَقتِ تَنَائِي"],
      [  "أَحِنُّ إِلَيْـهِ حَيْثُ كُنْتُ وَ إِنْ دَنَتْ", "مَرَابِعُهُ زَخْرَفْتُ فِيهِ ثَنَآئِي"],
      [  "تَطَاوَلَ لَيْلِي فِي دَكَارَ مُؤَرِّقًا", "حَنِينًا لِمَنْ بَيْنَ النَّقَا وَ قُبَاءِ"],
      [  "بِبَارِيسَ لَيْلاً قَدْ أَرِقْتُ تَشَوُّقًـا", "جَفَانِي مَنَامِي اللَّيْلَ كُـلَّ جَفَآءِ"],
      [  "بِبَارِيسَ لَكِنِّي أَرُوحُ لِطَيْبَةٍ", "قَدِ ازْدَدتُّ شَوْقًا عِنْدَ قُرْبِ لِقَاءِ"],
      [  "إِلَى الْحَرَمِ الْعَالِي الرَّفِيعِ مَنَـارُهُ", "إِلَى مَرْقَدِ الْمَاحِي الضَّلَالِ رِوَآئِي"],
      [  "إِلَى حُجُرَاتٍ عَظَّمَ اللَّهُ شَأْنَهَا", "بِذَمِّ مُنَادٍ حَوْلَهَا بِجَفَآءِ"],
      [  "إِلَى حُجُرَاتٍ طَهَّرَ اللَّهُ أَهْلَهَا", "مِنَ الرِّجْسِ وَالْفَحْشَا وَكُلِّ طَخَاءِ"],
      [  "مَصَادِرُ آيَاتٍ مَـوَارِدُ رَحْمَـةٍ", "بِهَا الرَّوْضُ فِيهَا حَلَّ وَحْيُ سَمَآءِ"],
      [  "مَحَطَّةُ أَنْظَارِ السَّمَاءِ وَ مُنْتَهَى", "مَسِيرِ الْمَلَا الْعَالِي شُرُوفَ ضِيَاءِ"],
      [  "فَلَاْيًا صَفَا وَقْتِي وَ بَاتَ مُؤَمَّلِي", "قَرِيبًا وَ حُبُّ الْهَاشِمِيِّ غِذَآئِي"],
      [  "تَرَى خَنْدَقَ الْمَاحِي الضَّلَالِ بِهِ اخْتَفَى", "دُجَى الْكُفْرِ وَالْأَهْوَا وَ كُلُّ عَنَآءِ"],
      [  "أَنَالُ وُقُوفًا خَاضِعًا مُتَأَدِّبًا", "أَمَامَ الْإِمَامِ الْقَرْمِ وَهْوَ شِفَآئِي"],
      [  "وَقَفْتُ أَمَامَ الْهَاشِمِيِّ مُصَلِّيًا", "لِرَبِّي فَوَافَانِي كَمَالُ هَنَآءِ"],
      [  "أُصَلِّي أَمَامِي الْحَقُّ جَلَّ جَلَالُهُ", "وَ خَلْفِي إِمَامِي الْهَاشِمِي بِإِزَآئِي"],
      [  "مَلَاذِيَ عَبْدَ اللَّهِ سَيِّدَ خَلْقِهِ", "أَتَيْتُ وَ تَدْرِي مَا تَرَكْتُ وَرَآئِي"],
      [  "فَسَلْ خَالِقِي تَفْرِيجَ كَرْبِي وَ كَرْبَ مَنْ", "تَعَلَّقَ بِي إِنِّي بَرِيدُ رَجَآءِ"],
      [  "رَسُولُ شُعُوبٍ يَنْتَمُونَ لِأَحْمَدٍ", "بِحُبٍّ وَ إِخْلَاصٍ وَ صِدْقٍ وَلَآءِ"],
      [  "تَحَدَّاهُمُ أَعْدَا الْحَنِيفَةِ جَهْرَةً", "إِلَى خَالِقِي شَكْوَى صَبَاحَ مَسَآءِ"],
      [  "سَأَلْتُ إِلَهِي أَنْ يُذِلَّ بِسُرْعَـةٍ", "عِصَابَاتِ إِسْرَائِيلَ أَهْـلَ غَبَـآءِ"],
      [  "وَ طَهِّرْ لَنَا الْقُدْسَ الشَّرِيفَ وَ أَهْلِكَنْ", "إِبَانًا وَ دَيَّانًا رِقَابَ إِمَآءِ"],
      [  "لَقَدْ حَارَبُوا عِيسَى وَ يَحْيَى وَ أَحْمَدَا", "فَهَبْ لِيَهُودَ الْقُدْسِ كُلَّ بَـلَآءِ"],
      [  "وَ حَرِّرْ لَنَا سِينًا بِمُوسَى وَ أَحْمَدٍ", "وَ عِيسَى وَ إِبْرَاهِيمَ أَهْلِ عَـلَآءِ"],
      [  "وَ تَخْفِضُ جُونْسُونًا بِجَاهِ مُحَمَّـدٍ", "وَ سِرِّ الَّذِي قَدْ جَا بِغَارِ حِـرَآءِ"],
      [  "وَ بَعْدَ لَيَالٍ فِي سُرُورٍ وَ غِبْطَـةٍ", "سَبَحْنَا إِلَى الْبَطْحَآءِ بَحْرَ فَضَآءِ"],
      [  "فَمَكَّةُ هَذِي ذَا الْمَقَامُ وَ هَذِهِ", "جِبَالُ ثَبِيرٍ فِي سَنًى وَ سَنَآءِ"],
      [  "وَ ذِي عَرَفَاتٍ ذَاكَ جَمْعٌ وَ مَشْعَرٌ", "بِهَا وَقَفَ الْمَاحِي لِمَحْوِ الشَّقَآءِ"],
      [  "يُؤُمُّكَ وَفْدٌ قَدْ طَوَى الْأَرْضَ طَآئِـرًا", "إِلَى الْمُصْطَفَى الْمُخْتَارِ بَحْرِ عَطَآءِ"],
      [  "مَعِي صَاحِبِي حِبِّي وَ صِهْرِي وَ خَادِمِي", "أَبُو حَرَمِي بِلْقِيسَ أَهْـلِ وَفَـآءِ"],
      [  "جَزَاهُمْ إِلَـهِي كُلَّ خَيْرٍ وَ يَعْلُـوَنْ", "بِنَاؤُهُمُ فِي الْمَجْدِ كُلَّ بِنَآءِ"],
      [  "فَهَبْ لِي وَ هَبْ عَبْدَ الْمَلِيكِ مُرَادَهُ", "بِلاَ سَبَبٍ إِلاَّ صُـدُورَ قَضَآءِ"],
      [  "وَ تَقْبَلُنَا هَـبِ الْمُسِيئِينَ جُمْلَةً", "لِمُحْسِنِنَا هَبْنِي لِعَيْنِ الصَّفَآءِ"],
      [  "جَزَى اللَّهُ عَنِّي وَالِدِي وَ مُعَلِّمِي", "لَدَى حَضْرَةِ الْمَنَّانِ كُلَّ جَزَآءِ"],
      [  "بِلاَغُوسَ أَحْبَابٌ كِـرَامٌ أَجِلَّـةٌ", "فَأَذْكُرُهُمْ أُهْـدِي لَهُـمْ بِدُعَآئِي"],
      [  "بِأَزَرِي بِكَانُو مِنْ أُكَيْنِي لِكَوْلَـخٍ", "فَتَذْكَارُهُمْ عِنْدِي بِوَقْتِ صَفَآءِ"],
      [  "عَلَيْـكَ صَـلاَةُ اللَّهِ ثُـمَّ سَلاَمُـهُ", "أَنَالُ لَدَى الْمَوْلَى كَمَلَ رِضَآءِ"],
      [  "عَلَيْـكَ صَـلاَةُ اللَّهِ ثُـمَّ سَلاَمُـهُ", "وَ ذَا سَيْرُ قَلْبِي وَهُوَ مَحْضُ عَطَآءِ"],
      [  "عَلَيْـكَ صَـلاَةُ اللَّهِ ثُـمَّ سَلاَمُـهُ", "وَ تُلْحِقُنِي بِالْآلِ أَهْلِ عَبَآءِ"],
      [  "عَلَيْكَ صَـلاَةُ اللَّهِ ثُـمَّ سَلاَمُـهُ", "لِطَهَ مَسِيرِي وَهُوَ مِنْهُ حِبَآئِي"],
      [  "أَسِيرُ بِـهِ لِلَّهِ جَــلَّ جَلاَلُـهُ", "وَ فُزْتُ بِجَمْعٍ حِينَ تَمَّ فَنَآئِي"],
      [  "فَخَيَّمَ قَلْبِي عِنْدَ أَحْمَـدَ لاَ أُرَى", "أَمِيلُ إِلَى الْأَغْيَارِ بَعْـدَ بَقَآءِ"],
      [  "أَرَى كُلَّ شَيْءٍ مَا خَلاَ اللَّهَ بَاطِلاً", "فَحَقَّ يَقِينِي إِذْ أَمَـاطَ غِطَآئِـي"],
      [  "عَلَيْـهِ صَـلاَةُ اللَّهِ ثُـمَّ سَلاَمُـهُ", "بِطَهَ سُرُورِي بِالْأَمِينِهِبَآئِي"],
      [  "عَلَيْـهِ مَعَ الْآلِ الْكِرَامِ وَ صَحْبِهِ", "صَـلاَةٌ وَ تَسْلِيمٌ خِتَامُ ثَنَائِي"]
    ]
