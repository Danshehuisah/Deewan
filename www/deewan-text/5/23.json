{
    "id": 23,
    "title": "حرف الثاء",
    "huruf": [
      ["ثَنَاءَ رَسُولِ اللَّهِ دَهْرِيَ اُحْدِثُ", " وَذَالِكَ عَهْدٌ دَآئِمًا لَسْتُ اَنْكُثُ"],
      ["بِقَبْضٍ وَبَسْطٍ لَا اُعَمِّلُ فِكْرَتِى", "لِمَدْحِ سِوَى الْمَاحِى بِذَا اَتَحَنَّثُ"],
      ["وَمَالِيَ زَادٌ فِي الْمَعَادِ سِوَاؤُهُ", "فَلَيْتِى بِقَلْبِى رُوحُكَ الْقُدْسِ يَنْفُثُ"],
      ["اَلَا يَارَسُولَ اللَّهِ فَارْثِ لِحَالَتِى", "خَدِيمٌ عَلَى سَرْدِ الْمَدَآئِحِ يَمْكُثُ"],
      ["يُزَاحِمُ حَسَّانًا وَكَعْبً لِمَدْحِكُمْ", "فَلَيْتِى اُرَى فِى سِلْكِهِمْ فَاُثَلِّثُ"],
      ["عَلَى عَرَجِي خَلْفَ الْجِيَادِ مُخَلَّفًا", "فَلَمْ أَرْضَ بِالسَّفْسَافِ وَقْتِيَ اُجْدَثُ"],
      ["وَأَنْتَ كَرِيمٌ جَابِرٌ ذُو مَكَانَةٍ", "أَعِثْنِي وَتُغْنِينِي فَفِيكَ أُحَدِّثُ"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَفِيكَ تِجَارَاتِى بِمَدْحِكَ أَحْرِثُ"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَكُونُ خَدِيمًا عَهْدَهُ لَيْسَ يَنْكُثُ"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ بَلَّغُواْ وَتَحَدَّثُواْ"]
    ]
  }