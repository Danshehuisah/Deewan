{
    "id": 13,
    "title": "حرف الميم",
    "huruf": [
      ["مَدِينَةُ خَيْرِ الْخَلْقِ طَيْبَةَ أَعْظَمُ", "بِلَادِ إِلَهِ الْعَالَمِينَ وَأَفْخَمُ"],
      ["مَحَلَّةُ نَصْرِ الْمُصْطَفَى وَجُنُودِهِ", "وَأَنْصَارِهِ وَهْوَ النَّبِيُّ الْمُعَظَّمُ"],
      ["وَفِيهَا مَمَرٌّ لِلنَّبِى وَمَقَرُّهُ", "بِهَالْبُقْعَةُ الْعُلْيَا مِنَ الْبَيْتِ أَعْظَمُ"],
      ["وَمَسْجِدُهُ أَعْظِمْ بِهِ وَبُيُوتُهُ", "وَءَابَارُهُ وَالْعِلْمُ فِيهَا مُقَسَّمُ"],
      ["تَرَدَّدَ جِبْرِيلُ الْأَمِينُ لِأَهْلِهَا", "خَدِيمًا وَمِيكَائِيلُ وَالْأَمْرُ أَجْسَمُ"],
      ["فَهَلْ لِي مِنِ الْمَامٍ بِطَيْبَةَ زَائِرًا", "عَلَى الْمُصْطَفَى بِالْقُرْبِ مِنْهُ أُسَلِّمُ"],
      ["فَمَا لِي دَوًا فِي غَيْرِ ذَاكَ وَإِنَّنِي", "أَرَى رُكْنَ صَبْرِي كُلَّ وَقْتٍ يُهَدَّمُ"],
      ["تَجَلَّدْتُ حَتَّى عِيلَ صَبْرِي وَلَمْ أَطِقْ", "عَنِ الْمُصْطَفَى حَبْسِى وَإِنْ كُنْتُ أُجْرِمُ"],
      ["اُنَادِيكَ خَيْرَ الْخَلْقِ حَيًّا لِتَسْمَحَنْ", "بِعَوْدِي لَهَا إِذْ مَا حَلَالِيَ فِي مَطْعَمُ"],
      ["اُكَاتِمُ وَجْدًا لَا يَرِيمُ فَخَاطِرِي", "اِلَى طَيْبَةِ الْغَرَّاءِ وَالْحُبُّ يُسْقِمُ"],
      ["لَئِنْ وَطِئَتْ رِجْلِي دِيَارَ مُحَمَّدٍ", "اَصُمْ وَاَقُمْ شُكْرًا لِرَبِّي فَأَغْنَمُ"],
      ["فَأَوَّلُ خَلْقِ اللَّهِ نُورُ مُحَمَّدٍ", "وَحَلَّ لِأَصْلَابِ الَّذِينَ قَدْ أَسْلَمُوا"],
      ["وَكُلُّ رَسُولٍ نَآئِبٌ عَنْ نَبِيِّنَا", "فَهُو الْآخِرُ الْمَخْتُومُ وَهْوَ الْمُقَدَّمُ"],
      ["فَأَيَاتُهُمْ آيَاتُهُ وَنَبِيُّنَا", "أَتَى بِكِتَابٍ شَأْنُهُ الدَّهْرَ يُفْخَمُ"],
      ["أَتَى بِجِهَادِ الْكَافِرِينَ فَاُرْعِبُوا", "فَهَابُوا ظُبَى الْأَسْيَافِ طُرًّا وَاَسْلَمُوا"],
      ["وَشُقَّ لَهُ بَدْرٌ وَوَافَتْهُ دَوْحَةٌ", "وَالْاَحْجَارُ فِي الْبَطْحَآءِ كَانَتْ تُسَلِّمُ"],
      ["وَفَاضَتْ مِيَاهٌ مِنْ بَنَانِ نَبِيِّنَا", "وَأَسْقَتْ جُيُوشًا كُلُّ جَيْشٍ عَرَمْرَمُ"],
      ["شَكَوْاْ جَهْدَهُمْ عِنْدَ النَّبِى فَسَقَاهُمُ", "غَمَامٌ بِوَدْقٍ سَيْبُهَا لَيْسَ يُفْصَمُ"],
      ["سَقَاهُمْ كَذَا الْفَارُوقُ بِالْعَمِّ عَمِّهِ", "بِذِكْرِهِمُ اَسْقِى الْبِلَادَ وَاُفْعِمُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِأَلْقَى بِهَا الْمَوْلَى وَقَلْبِي مُسَلِّمُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَيَنْشُرُ هَدْيِى فِي الْوَرَى وَيُعَمِّمُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِيَقْبَلَنِى الْمُخْتَارُ وَالْعِلْمَ أَعْلَمُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِكُلِّ مُرِيدٍ آخِرَ الدَّهْرِ سُلَّمُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "بِذِكْرِكَ بَدْءٌ وَهْوَ ذِكْرُكَ مَخْتَمُ"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "صَلَاةٌ وَتَسْلِيمٌ بِذَيْنِكَ اَخْتِمُ"]
    ]
