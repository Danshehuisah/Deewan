{
    "id": 5,
    "title": "حرف الهاء",
    "huruf": [
      ["هُوَ الْمُصْطَفَى مَنْ لَمْ يَثِقْ بِعُرَاهُ", "هَوَى فِي جَحِيمٍ إِذْ غَوَى بِهَوَاهُ"],
      ["سَبِيلُ سَلَامٍ فِي اقْتِفَاءِ صِرَاطِهِ", "هُوَ الْبَابُ لِلْمَوْلَى وَلَيْسَ سِوَاهُ"],
      ["دَعَا الْخَلْقَ لِلْمَوْلَى بِكُلِّ نَصِيحَةٍ", "فَلَبَّى الَّذِي قَدْ زَالَ عَنْهُ شَقَاهُ"],
      ["عَتِيقٌ وَهُو خَيْرُ الْوَرَى بَعْدَ رُسْلِهِمْ", "أَبُو حَفْصٍ الْفَارُوقُ بَعْدُ تَلَاهُ"],
      ["وَعُثْمَانُ ذُو النُّورَيْنِ وَاللَّيْثُ سَيِّدِي", "أَبُو حَسَنٍ صِنْوُ النَّبِيِّ وَثِنَاهُ"],
      ["وَطَلْحَةُ سَعْدٌ وَالزُّبَيْرُ سَعِيدُهُمْ", "وَعَامِرُ وَالْعَوْفِيُّ زَيْنُ مَلَاهُ"],
      ["وَخَيْرُ قُرُونٍ ثُمَّ قَرْنٌ يَلِيهِمُ", "وَقَرْنٌ يَلِيهِمْ فُضِّلُوا بِحِبَاهُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَلَا أَنْتَحِى إِلَّا لِنَحْوِ رِضَاهُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُفِيضُ لِهَاذَا الْعَبْدِ فَيْضَ عَطَاهُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَتَكْفِي لِهَاذَا الْعَبْدِ كُلَّ عِدَاهُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا نَالَ الْعُبَيدُ مُنَاهُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُسَخِّرُلِي دَهْرِي لِيَوْمِ لِقَاهُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَأَصْحَابٍ عَلَوْا بِعُلَاهُ"]
    ]
  }