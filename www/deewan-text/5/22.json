{
    "id": 22,
    "title": "حرف التاء",
    "huruf": [
      ["تَخِذْتُ رَسُولَ اللَّهِ فِي كُلِّ أَوْقَاتِي", "مَعَاشِي وَكَسْبِي فَهْوَ لِي خَيْرُ أَقْوَاتِى"],
      ["وَأَمْدَحُهُ مَا عِشْتُ فِي كُلِّ حَالَةٍ", "قَصِيدِي مَدِيحُ الْهَاشِمِيِّ وَأَبْيَاتِي"],
      ["فَلِي كُلَّ وَقْتٍ حَالَةٌ بَعْدَ حَالَةٍ", "وَحَالَةُ مَدْحِ الْمُصْطَفَى خَيْرُ حَالَاتِي"],
      ["وَلِي زَفْرَةٌ لِلْحُبِّ مِنْ بَعْدِ زَفْرَةٍ", "فَيَرْحَمُ خَيْرُ النَّاسِ صَدْرِي وَأَوْقَاتِي"],
      ["وَطَالَ بُكَائِي فَالزَّفِيرُ جَهَنَّمُ", "يُهَوِّنُهُ مِنِّى دُمُوعِي وَأَصْوَاتِي"],
      ["يُدَارِكُنِي طَاهَ الْأَمِينُ بِعَطْفَةٍ", "فَيَعْذُبُ تَعْذِيبِي وَوَجْدِي وَلَوْعَاتِي"],
      ["اَنِلْنِى مَقَامً قَدْ تَقَاصَرَ دُونَهُ", "جَمِيعُ فُحُولٍ فِي زَمَانِي وَمَايَاتِي"],
      ["بِلَا سَبَبٍ مِنِّي مُعَافًى فَإِنَّنِي", "رَجَاءِ كَبِيرٌ فِي مَلَاذِى وَمَنْجَاتِى"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "عَلَى عَدَدِ الْمَاضِي كَذَا عَدَدِ الْآتِى"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا فَقْرِى يَزُولُ وَفَاقَاتِى"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "بِهَادَامَ لِي ذِكْرِى وَرُوحِى وَرَاحَاتِى"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا يَعْلُواْ لِوَائِي وَرَايَاتِى"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاتِى وَتَسْلِيمِى عَلَى الْحُبِّ ءَايَاتِى"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "بِهَا يَقْبَلُ الْمَوْلَى جَمِيعَ قِرَاءَاتِى"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "صَلَاةً بِهَا رَفْعِى وَرَفْعُ مَكَانَاتِى"]
    ]
  }