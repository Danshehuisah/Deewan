{
    "id": 25,
    "title": "حرف الذال",
    "huruf": [
      ["ذَكَرْتُ الَّذِي بِالذِّكْرِ مِنْهُ تَلَذُّذِ", "نَبِيًّا بِعُلْيَاهُ عَلَا كُلَّ جِهْبِذِ"],
      ["مُحَمَّدُ أُنْسِي وَهْوَ كَنْزِي وَمَلْجَئِي", "وَسِرِّي وَمِنْ كُلِّ الْبَلِيَّاتِ مُنْقِذِي"],
      ["وَهُوَ الَّذِي لَمْ يَدْعُ دَاعٍ بِذِكْرِهِ", "وَلَمْ يُسْتَجَبْ وَالذِّكْرُ عَيْنُ تَلَذُّذِ"],
      ["بِهِ آدَمٌ قَدْ تِيبَ حِينَ تَقَطَّعَتْ", "وَسَآئِلُهُ مَا إِنْ يَرَى مِنْ مُنَقِّذِ"],
      ["وَنُوحٌ وَإِبْرَاهِيمُ مُوسَى وَيُونُسٌ", "وَعِيسَى وَإِسْمَاعِيلُ وَالْكُلُّ جِهْبِذِي"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَإِنِّى لِوَصْلِ الْمُصْطَفَى الْغَوْثِ كَالَّذِي"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَلَا أَكُ يَوْمًا فِي سِوَاهُ تَلَذُّذِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَجُودُ بِمَدْحٍ فَآئِقٍ لِزُمُرُّذِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَغِثْنَا بِيُمْنِ الْهَاشِمِيِّ وَأَنْقِذِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِتُطْرِحْ رُؤُوسَ الْكُفْرِ طُرًّا وَتَنْبُذِ"]
    ]
  }