{
    "id": 10,
    "title": "حرف الياء",
    "huruf": [
      ["يُذَكِّرُنِي الْبَرْقُ الْوَمِيضُ الْمَغَانِيَا", "عَقِيقًا وَسَلْعًا وَالْنَّقَى وَالْعَوَالِيَا"],
      ["قَعَدْتُ لَهُ بِكُوسِ وَالْحَيُّ كُلُّهُمْ", "رُقُودٌ أَشِيمُ الْمُعْصِرَاتِ السَّوَارِيَا"],
      ["سَقَى اللَّهُ مِنْ تِلْكَ الْمُزُونِ مَرَابِعًا", "تَوَطَّنَهَا الْمُخْتَارُ لِلْكُفْرِ مَاحِيَا"],
      ["حَمَى عَنْ جُفُونِي النَّوْمَ حُبُّ مُحَمَّدٍ", "بِتَذْكَارِهِ لَيْلِى سَلَوْتُ الْغَوَانِيَا"],
      ["أَبِيتُ بِلَيْلٍ نَابِغِيٍّ وَقَدْ سَرَتْ", "حُمَيَّا وِدَادِي فِي جَمِيعِ حَشَآئِيَا"],
      ["أُنَادِي حَبِيبَ اللَّهِ طَاهَ مُحَمَّدًا", "أَبَا الْقَاسِمِ الْهَادِي الْمُقَفَّى مُنَاجِيَا"],
      ["لِتَرْحَمْ خَدِيمًا ضَارِعًا عِنْدَ بَابِكَ الْـ", "ـمُؤَمَّلِ يَا مَحْمُودُ فَانْظُرْ لِحَالِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا نَيْلِي الْعُلَى وَالْمَعَالِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا أَلْقَى لَدَيْكَ الْأَمَانِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا أَهْدَى فَاَصْبَحُ هَادِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا أَبْقَى كَرِيمًا مُوَاسِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَكُونُ بِهَا فَرْدًا عَلَى الْكُلِّ سَامِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا أَبْقَى وَفَيْضِيَ جَارِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "يَكُونُ بِهَا نَسْلِي هُدَاةً وَءَالِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تَصُونُ بِهَا مِصْرِي الْعُصُورَ الْخَوَالِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِيُرْضِى رَسُولَ اللَّهِ كُلُّ ثَنَآئِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "يُجِيبُ بِهَا الْمَوْلَى جَمِيعَ دُعَائِيَا"],
      ["عَلَيْكَ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ شَيَّدُوا الدِّينَ عَالِيَا"]
    ]
