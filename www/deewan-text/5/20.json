{
    "id": 20,
    "title": "حرف الراء",
    "huruf": [
      ["رَسُومِيَ أَمْدَاحُ النَّبِيِّ وَلَا فَخْرَا", "فَمَا فِي سِوَى مَدْحِي لَهُ أَنْسِجُ الشِّعْرَا"],
      ["رَفَضْتُ جَمِيعَ الشِّعْرِ غَيْرَ مَدِيحِهِ", "سِوَى دَعْوَةِ الْمَوْلَى أَوَانْ أَقْصُدَ الذِّكْرَى"],
      ["رَجَعْتُ إِلَى الْمَوْلَى بِاَحْمَدَ عَاشِقًا", "وَأَمْسَيْتُ مِنْ مَدْحِ النَّبِي أَعْتَلِي الْشِّعْرَا"],
      ["رَقَيتُ ذُرَى الْعِرْفَانِ فِي الْعِلْمِ فَآئِقًا", "وَرُضْتُ عَوِيصَاتِ الْعُلُومِ وَلَا فَخْرَا"],
      ["رَأَيْتُ رَسُولَ اللَّهِ جَادَ بِبُغْيَتِى", "وَمَا غَابَ عَنِّي الدَّهْرَ بَرًّا وَلَا بَحْرَا"],
      ["رَفَعْتُ لِوَاءَ الذِّكْرِ وَالْمَدْحِ غَارِفًا", "بِبَحْرِ حَبِيبِي حَيْثُ اَلْهَمَنِى الذِّكْرَى"],
      ["رِمَاحِى وَاَسْيَافِ النَّبِى وَكِنَانَتِى", "وَاَرْمِى بِهِ وَجْهَ الَّذِى يَقْصُدُ الضُّرَّا"],
      ["رَمَيْتُ بِهِ فِي عَيْنِهِمْ وَنُحُورِهِمْ", "وَقَدْ سُلِبُواْ مِنْ عِزِّهِمْ عُوِّضُواْ فَقْرَا"],
      ["رَمَوْنِي وَمَا نَالُوا مُرَادًا وَإِنَّنِي", "بِذِكْرِ رَسُولِ اللَّهِ أَقْتُلُهُمْ صَبْرَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِيَاخُذَلِي ثَارِي وَلَمْ اَكْتَسِبْ وِزْرَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَسُوسُ بِهَا قَرْنِي لِمَا يُصْلِحُ الْأُخْرَى"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا تُسْقِى الْبَسَاتِينَ وَالنَّهْرَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُدِيمُ لَنَا الْعَلْيَاءَ وَالْمَجْدَ وَالسِّتْرَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا تُشْكِى الشِّكَايَتِ لِي الْدَّهْرَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِيَقْبَلَ خَيْرُ الْخَلْقِ نَظْمِيَ وَالنَّثْرَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِتَمْحُواْ بِيَ الْأَضْلَالَ وَالشِّرْكَ وَالْكُفْرَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُعِزُّ بِهَا صَحْبِي وَتَكْفِيهِمُ الشَّرَّا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُسَهِّلُ حَجَّ الْبَيْتِ وَلْتَطْوِ لِي الْقَفْرَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "تُسَخِّرُلِى كُلَّ الْبَرَايَا وَلَا فَقْرَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَأَصْحَابٍ هُمُ الدَّوْلَةُ الْكُبْرَى"]
    ]
  }