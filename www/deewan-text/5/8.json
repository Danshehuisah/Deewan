{
    "id": 8,
    "title": "حرف الحاء",
    "huruf": [
      ["حَمَانِي رَسُولُ اللَّهِ عَنْ كُلِّ رَامِحِ", "عَلَى رَغْمِ غَادٍ لِلْبِرَازِ وَرَائِحِ"],
      ["حَمَانِي رَسُولُ اللَّهِ عَنْ مَكْرِ مَاكِرٍ", "وَشُؤْمٍ لِذِى شُؤْمٍ وَكُلِّ الْجَوَآئِحِ"],
      ["وَسِحْرٍ لِذِي سِحْرٍ وَعَيْنٍ لِعَآئِنٍ", "فَمَنْ رَامَ ضُرِّي قَدْ سَعَى فِي مَصَالِحِ"],
      ["بِيُمْنِ رَسُولِ اللَّهِ كَهْفِي وَمَلْجَإِي", "فَمَا مُبْغِضُ الْعَبْدِ الْحَقِيرِ بِرَابِحِ"],
      ["نَصَحْتُ لِمَنْ يَبْغِي السَّلَامَةَ وَالْعُلَا", "يُخَلِّي عَنِ الْمَدَّاحِ مِنْ كُلِّ قَادِحِ"],
      ["فَإِنَّ رَسُولَ اللَّهِ حَامِي ذِمَارِهِ", "وَقَدْ جَاءَ مَنْصُورًا عَلَى كُلِّ كَادِحِ"],
      ["وَقَدْ كُفِيَ الْأَحْزَابَ يَوْمَ تَحَزَّبُوا", "وَرُدُّوا بِغَيْظٍ بِالْبَلَا يَاالْفَوَادِحِ"],
      ["وَإِنِّي مَعَ الْمُخْتَارِ فِي كُلِّ حَالَةٍ", "بِحُبٍّ وَذِكْرٍ ثُمَّ قَرْضِ الْمَدَآئِحِ"],
      ["فَمَنْ رَاشَ نَحْوِي سَهْمَهُ فَهْوَ رَآئِشٌ", "إِلَى نَحْرِهِ فَلْيُنْذَرَنْ بِالْقَوَادِحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "أَنَالُ بِهَا كُلَّ الْمُنَى وَالْمَرَابِحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِيَرْفَعَنِي الْهَادِي عَلَى كُلِّ مَادِحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِتَمْلَأَ مِنْ حُبِّ الْأَمِينِ جَوَانِحِي"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِيَقْبَلَ سَعْيِ ثُمَّ كُلَّ الْمَدَآئِحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَتُسْقَى اَرَاضِي بِالْمُزُونِ الدَّوَالِحِ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا نُجْحِى وَكُلُّ الْمَصَالِحِ"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "وَمَنْ يَقْتَفِي مِنْ كُلِّ بَرٍّ وَصَالِحِ"]
    ]
  }