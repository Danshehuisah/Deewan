{
    "id": 3,
    "title": "حرف الجيم",
    "huruf": [
      ["جَزَى اللَّهُ عَنِّى ظُلْمَةَ اللَّيْلِ وَالدُّجَى", "فَفِيهَا يَنَالُ الصَّبُّ لِلْحُبِّ مَخْرَجَا"],
      ["يَبِيتُ يُرَاعِي النَّجْمَ وَالْكُلُّ رَاقِدٌ", "يُنَظِّمُ دُرًّا بَلْ يُنَظِّمُ أَبْهَجَا"],
      ["تَذَكَّرَ خَيْرَ الْخَلْقِ طَاهَ مُحَمَّدًا", "جَمِيلَ الْمُحَيَّا أَبْلَجًا كَانَ أَدْعَجَا"],
      ["عَظِيمٌ عَظِيمُ الْخُلْقِ وَالْجُودِ وَالْعَطَا", "شَفِيقٌ شَفِيعٌ مِنْ دُجَى الْكُفْرِ مُخْرِجَا"],
      ["وَذَاكَ الَّذِي لَوْلَاهُ مَا كَانَ كَائِنٌ", "وَلَوْلَاهُ لَمْ نَسْلُكْ إِلَى الْحَقِّ مَنْهَجَا"],
      ["دَعَا الْخَلْقَ لِلْمَوْلَى بِكُلِّ فِعَالِهِ", "وَفِي حَقِّهِ يَغْدُواْ وَرَاحَ وَاَدْلَجَا"],
      ["قَلَوْهُ وَآذَوْهُ بِكُلِّ أَاِذَايَةٍ", "فَقَادَ الْبَرَايَا لِلْحَنِيفَةِ مُولِجَا"],
      ["وَجَاهَدَهُمْ فِي اللَّهِ حَقَّ جِهَادِهِ", "وَنَوَّرَ أَقْطَارَ الْبِلَادِ وَاَسْرَجَا"],
      ["أَلَمْ يَاتِهِمْ مَا قَدْ لَقَوهُ بِبَدْرِهِ", "وَقَدْ بَزَغَ الدِّينُ الْحَنِيفِيُّ أَبْلَجَا"],
      ["كَذَا اُحُدًا جَائُواْ وَبَائُواْ بِصَدْمَةٍ", "فَوَلُّواْ فِرَارًا حَيْثُمَا الرُّعْبُ أَزْعَجَا"],
      ["وَقَدْ قَادَ لِلْبَطْحَاءِ جَيْشًا عَرَمْرَمًا", "فَذَلُّوا وَقَدْ دَانُوا مِنَ الْخَوْفِ وَالرَّجَا"],
      ["فَيَا رَبِّ هَبْ لِي بِالْأَمِينِ وَصَحْبِهِ", "كَمَالَ مُرَادٍ لِلسَّعَادَةِ مُنْتِجَا"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "مَعَ الْآلِ وَالصَّحْبِ الْكِرَامِ وَمَنْ نَجَا"]
    ]
  }