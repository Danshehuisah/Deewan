{
    "id": 24,
    "title": "حرف الخاء",
    "huruf": [
      ["خَدَمْتُ رَسُولَ اللَّهِ دَهْرِيَ أَنْسَخُ", "مَدَائِحَهُ وَالْحُبُّ فِي الْقَلْبِ يَرْسَخُ"],
      ["لَقَدْ خَصَّهُ الْمَوْلَى بِأَعْلَى كَرَامَةٍ", "شَرِيعَتُهُ كُلَّ الشَّرَائِعِ تَنْسَخُ"],
      ["وَقَدْ جَاءَ فِي الذِّكْرِ الْحَكِيمِ ثَنَاؤُهُ", "مِنَ اللَّهِ نَتْلُوهُ إِلَى يَوْمِ يُنْفَخُ"],
      ["مِنَ الْحَرْفِ وَالتَّبْدِيلِ صَانَ إِلَاهُنَا", "كِتَابًا لَهُ وَالْهُودُ مِنْ ذَاكَ مُسِّخُوا"],
      ["وَقَدْ أَعْجَزَى اللُّسْنَ الْمَصَاقِعَ نَظْمُهُ", "فَلَمْ يَحْكِ شِبْهَ الذِّكْرِ يَوْمًا مُوَرِّخُ"],
      ["بِهِ نَارَ أَقْطَارُ الْبِلَادِ كَأَنَّهُ", "ضِيَاءُ نَهَارٍ مِنْ دُجَى الَّيْلِ يَسْلَخُ"],
      ["بِهِ يُرْزَقُ الْاَمْطَارَ فَالْيُمْنُ كُلُّهُ", "مِنَ الذِّكْرِ فَلْيُصْرِخْ بِذَا الذِّكْرِ مُصْرِخُ"],
      ["فَإِنَّ وُجُودَ الْمُصْطَفَى وَكِتَابِهِ", "لَأَكْبَرُ آلَاءٍ بِذَيْنِ يُؤَرِّخُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "فَيُطْوَى عَنِ الْبَطْحَاءِ تَيْمَاءُ سَرْبَخُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "لِأَحْيَى وَمَا بَيْنِي وَبَيْنَكَ فَرْسَخُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "بِهَا طَابَ لِي دُنْيَا وَأُخْرَى وَبَرْزَخُ"],
      ["عَلَيْهِ مَعَ الْآلِ الْكِرَامِ وَصَحْبِهِ", "صَلَاةً بِهَا أَبْقَى وَمَدْحَكَ أَنْسَخُ"]
    ]
  }