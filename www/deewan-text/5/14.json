{
    "id": 14,
    "title": "حرف النون",
    "huruf": [
      ["نُوَحِّدُ مَوْلَانَا بِاَحْمَدَ نُومِنُ", "وَبِالرُّسْلِ وَالْأَمْلَاكِ وَهْوَ الْمُهَيْمِنُ"],
      ["وَنُحْجِمُ طَوْرًا عَنْ ثَنَاءِ نَبِيِّنَا", "قُصُورًا وَطَوْرًا بِالْمَدَآئِحِ نُعْلِنُ"],
      ["وَاِنْ كُنْتُ لَمْ أُحْسِنْ مَدِيحَ مُحَمَّدٍ", "اُسَوِّدُ أُورَاقًا بِحُبِّكَ أُعْلِنُ"],
      ["وَإِنْ كَتَبُواْ الْمَدَّاحُ يَوْمًا وَاَثْبَتُوا", "سُمَاتِي اَكُنْ مِثْلَ الَّذِينَ قَدَ احْسَنُوا"],
      ["فَيَا فَوْزَ إِبْرَاهِيمَ إِنْ جَاءَ ذِكْرُهُ", "بِزُمْرَةِ مَنْ يُثْنِي عَلَيْكَ وَيُحْسِنُ"],
      ["وَتَرْكِى تَمَامًا لِلْقُصُورِ اَظُنُّهُ", "مُحَالًا فَرَبِّى اللَّهُ لِلْكُلِّ مُحْسِنُ"],
      ["عَسَى الْمُصْطَفَى يَوْمًا يَجُودُ بِنَظْرَةٍ", "تُغَسِّلُ أَوْزَارِي وَقَلْبِيَ تُسْمِنُ"],
      ["وَإِنْ شَاءَ قَوَّانِي لِحَمْلِ خِلَافَةٍ", "لِكَيْ أَرْفَعَ التَّوْحِيدَ وَالْكُلُّ مُؤْمِنُ"],
      ["لِيُسْلِمَ جُلُّ النَّاسِ اَقْتُلُ بَعْضَهَا", "جِهَادًا وَإِنِّي مُومِنٌ بِكَ مُحْسِنُ"],
      ["فَاَرْفَعَ عِلْمًا لِلْجَهَالَةِ وَاضِعًا", "وَاَكْسِرَ رَايَاتِ الصَّلِيبِ وَاَدْفِنُ"],
      ["فَبِى يُرْفَعُ الْجَوْرُ الْعَظِيمُ فَلَا يُرَى", "سِوَى الْعِلْمِ وَالدِّينُ الْحَنِيفِى يُزَيَّنُ"],
      ["فَتُمْسِي رِجَالُ اللَّهِ فِي ظِلِّ رَاحَةٍ", "وَعِزٍّ وَتَمْجِيدٍ وَبِالْحَقِّ اَعْلَنُوا"],
      ["يَكُونُ زِمَامُ الْعَالَمِينَ جَمِيعِهِمْ", "بِأَيْدِي رِجَالٍ بِالْعُلُومِ تَمَكَّنُوا"],
      ["فَيَاتِي مَسِيحٌ وَالرِّجَالُ رِجَالُهُ", "بِدِينِ لِإِمَامِ الْهَاشِمِى يَتَدَيَّنُ"],
      ["هُنَالِكَ عَمَّ الْفَيْضُ لَا شَكَّ لَنْ تَرَى", "سِوَى عَارِفٍ بِاللَّهِ وَالشَّرْعِ مُتْقَنُ"],
      ["فَيَخْتِمُ عِيسَى لَا تَكُونُ وِلَايَةٌ", "بُعَيدَ مَمَاتِ الرُّوحِ فَالْخَيْرُ يُدْفَنُ"],
      ["فَإِنْ لَمْ يَكُنْ مَنْ يَذْكُرُ اللَّهَ زَلْزَلَتْ", "زَلَازِلُ سَاعَاتٍ وَنَادَى الْمُوَذِّنُ"],
      ["فَيَا رَبِّ حَقِّقْ بِالْأَمِينِ رَجَاءَنَا", "فَمَا لِي سِوَى أَنْ أَسْأَلَ اللَّهَ مَعْدِنُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "صَلَاةً بِهَا لِلدِّينِ قَصْرِيَ مَأْمَنُ"],
      ["عَلَيْهِ صَلَاةُ اللَّهِ ثُمَّ سَلَامُهُ", "وَآلٍ وَصَحْبٍ وَالَّذِينَ قَدْ أَحْسَنُوا"]
    ]
